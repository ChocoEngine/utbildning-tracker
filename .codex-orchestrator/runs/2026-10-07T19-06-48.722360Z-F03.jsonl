 RepositoryException(val error: RepositoryError) : IllegalArgumentException(error.name)\n    32\t\n    33\t/** Course writes, category resolution and color allocation share one transaction. */\n    34\tclass TrackerRepository(\n    35\t    private val database: TrackerDatabase,\n    36\t    private val now: () -> Long = System::currentTimeMillis,\n    37\t    private val newId: () -> String = { UUID.randomUUID().toString() },\n    38\t    private val zone: () -> ZoneId = { ZoneId.systemDefault() },\n    39\t) {\n    40\t    private val dao = database.trackerDao()\n    41\t    private val operations = TrackerOperations(database, now, newId, zone)\n    42\t\n    43\t    /** All portable rows are read under one Room transaction. */\n    44\t    suspend fun createBackupSnapshot(languageTag: String): BackupSnapshot = database.withTransaction {\n    45\t        BackupSnapshot(\n    46\t            languageTag = languageTag,\n    47\t            categories = dao.getCategories(),\n    48\t            courses = dao.getCourses(),\n    49\t            topics = dao.getAllTopics(),\n    50\t            schedules = dao.getAllSchedules(),\n    51\t            scheduleRules = dao.getAllScheduleRules(),\n    52\t            sessions = dao.getAllSessions().map { it.record() },\n    53\t        )\n    54\t    }\n    55\t\n    56\t    suspend fun saveInitialSchedule(courseId: String, rules: List<WeeklyRule>, endsOn: Long? = null) =\n    57\t        operations.saveInitialSchedule(courseId, rules, endsOn)\n    58\t    suspend fun updateSchedule(courseId: String, rules: List<WeeklyRule>, endsOn: Long? = null) =\n    59\t        operations.updateSchedule(courseId, rules, endsOn)\n    60\t    suspend fun getSchedule(courseId: String) = dao.getSchedule(courseId)\n    61\t    suspend fun getScheduleRules(courseId: String) = dao.getScheduleRules(courseId)\n    62\t    suspend fun getOccupiedSchedules(excludingCourseId: String) = database.withTransaction {\n    63\t        dao.getReminderCourses().filter { it.id != excludingCourseId }.mapNotNull { course ->\n    64\t            val schedule = dao.getSchedule(course.id) ?: return@mapNotNull null\n    65\t            com.utbildning.tracker.domain.OccupiedSchedule(course.id, course.name,\n    66\t                LocalDate.ofEpochDay(schedule.startsOn), schedule.endsOn?.let(LocalDate::ofEpochDay),\n    67\t                dao.getScheduleRules(course.id).map { WeeklyRule(it.dayOfWeek, it.startMinute, it.endMinute) })\n    68\t        }\n    69\t    }\n    70\t    fun observeOccupiedSchedules(excludingCourseId: String) =\n    71\t        database.invalidationTracker.createFlow(\"courses\", \"topics\", \"schedules\", \"schedule_rules\")\n    72\t            .map { getOccupiedSchedules(excludingCourseId) }.distinctUntilChanged()\n    73\t    fun observeSessions() = dao.observeSessions()\n    74\t    fun observeSessionsBetween(firstDate: Long, lastDate: Long) = dao.observeSessionsBetween(firstDate, lastDate)\n    75\t    fun observeReminderChanges(): Flow<Unit> =\n    76\t        database.invalidationTracker.createFlow(\"sessions\", \"courses\", \"topics\", \"schedules\", \"schedule_rules\")\n    77\t            .map { Unit }\n    78\t    fun observeTopicPaces(): Flow<Map<String, Int>> = merge(\n    79\t        database.invalidationTracker.createFlow(\"courses\", \"topics\", \"schedules\", \"schedule_rules\", \"sessions\").map { Unit },\n    80\t        flow { while (true) { emit(Unit); delay(com.utbildning.tracker.domain.millisUntilNextLocalDay(now(), zone())) } },\n    81\t    ).map {\n    82\t        database.withTransaction {\n    83\t            val currentZone = zone()\n    84\t            val instant = java.time.Instant.ofEpochMilli(now())\n    85\t            val today = instant.atZone(currentZone).toLocalDate()\n    86\t            val sessions = dao.getAllSessions().groupBy { it.courseId }\n    87\t            dao.getReminderCourses().mapNotNull { course ->\n    88\t                val schedule = dao.getSchedule(course.id) ?: return@mapNotNull null\n    89\t                val rules = dao.getScheduleRules(course.id).map { WeeklyRule(it.dayOfWeek, it.startMinute, it.endMinute) }\n    90\t                val remaining = dao.getTopics(course.id).count { !it.isCompleted }\n    91\t                val records = sessions[course.id].orEmpty()\n    92\t                val unavailable = records.filter { it.result != SessionResult.PENDING }\n    93\t                    .map { LocalDate.ofEpochDay(it.date) }.toMutableSet()\n    94\t                // A pending session remains actionable all day. Do not invent a past start\n    95\t                // when the calendar never created today's session.\n    96\t                if (records.none { it.date == today.toEpochDay() && it.result == SessionResult.PENDING } &&\n    97\t                    rules.none { it.dayOfWeek == today.dayOfWeek.value && SessionTime.start(today, it.startMinute, currentZone) >= instant })\n    98\t                    unavailable += today\n    99\t                com.utbildning.tracker.domain.TopicPace.perSession(remaining,\n   100\t                    LocalDate.ofEpochDay(schedule.startsOn), schedule.endsOn?.let(LocalDate::ofEpochDay),\n   101\t                    rules, today, unavailable)?.let { course.id to it }\n   102\t            }.toMap()\n   103\t        }\n   104\t    }.distinctUntilChanged()\n   105\t    /** A read-only snapshot; future result permissions do not restrict alarm planning. */\n   106\t    suspend fun getReminderCandidates(): List<SessionEntity> = database.withTransaction {\n   107\t        val yesterday = java.time.Instant.ofEpochMilli(now()).atZone(zone()).toLocalDate().minusDays(1)\n   108\t        dao.getReminderCandidates(yesterday.toEpochDay())\n   109\t    }\n   110\t\n   111\t    /** Validation and posting share the write transaction with lifecycle changes. */\n   112\t    suspend fun withCurrentReminders(trigger: Long, action: (SessionEntity) -> Unit) = database.withTransaction {\n   113\t        val currentZone = zone()\n   114\t        getReminderCandidates().forEach {\n   115\t            val date = LocalDate.ofEpochDay(it.date)\n   116\t            if (SessionTime.start(date, it.startMinute, currentZone).toEpochMilli() == trigger ||\n   117\t                    SessionTime.question(date, it.startMinute, it.endMinute, currentZone).toEpochMilli() == trigger) action(it)\n   118\t        }\n   119\t    }\n   120\t    suspend fun synchronize(throughDate: Long? = null) = operations.synchronize(throughDate)\n   121\t    suspend fun getSessionDetails(sessionId: String) = operations.getSessionDetails(sessionId)\n   122\t    fun observeSessionDetails(sessionId: String) = merge(\n   123\t        database.invalidationTracker.createFlow(\"sessions\", \"courses\", \"topics\").map { Unit },\n   124\t        // Date permissions also expire while the editor stays open across midnight.\n   125\t        flow { while (true) { emit(Unit); delay(com.utbildning.tracker.domain.millisUntilNextLocalDay(now(), zone())) } },\n   126\t    ).map { getSessionDetails(sessionId) }.distinctUntilChanged()\n   127\t    suspend fun setSessionResult(sessionId: String, result: SessionResult, selectedTopicIds: Set<String>? = null) =\n   128\t        operations.setSessionResult(sessionId, result, selectedTopicIds)\n   129\t    suspend fun applyPendingSessionAction(sessionId: String, result: SessionResult) =\n   130\t        operations.applyPendingSessionAction(sessionId, result)\n   131\t    suspend fun markSessionDoneIfNoTopics(sessionId: String): Boolean {\n   132\t        val details = getSessionDetails(sessionId) ?: throw RepositoryException(RepositoryError.SESSION_NOT_FOUND)\n   133\t        if (details.hasTopics) return false\n   134\t        setSessionResult(sessionId, SessionResult.DONE, emptySet())\n   135\t        return true\n   136\t    }\n   137\t    suspend fun completeCourse(courseId: String) = operations.completeCourse(courseId)\n   138\t    suspend fun pauseCourse(courseId: String) = operations.pauseCourse(courseId)\n   139\t    suspend fun disableSchedule(courseId: String) = operations.disableSchedule(courseId)\n   140\t    suspend fun deleteCourse(courseId: String) = operations.deleteCourse(courseId)\n   141\t\n   142\t    fun observeCourses(): Flow<List<CourseEntity>> = dao.observeCourses()\n   143\t\n   144\t    fun observeCoursesSnapshot(): Flow<CoursesSnapshot> =\n   145\t        database.invalidationTracker.createFlow(\"courses\", \"topics\", \"schedule_rules\", \"sessions\")\n   146\t            .map {\n   147\t                database.withTransaction {\n   148\t                    val courses = dao.getCourses()\n   149\t                    val topics = dao.getCourseTopicCounts().associateBy { it.courseId }\n   150\t                    val done = dao.getCourseDoneCounts().associateBy { it.courseId }\n   151\t                    val rules = dao.getAllScheduleRules().groupBy { it.courseId }\n   152\t                    CoursesSnapshot(courses, courses.associate { course ->\n   153\t                        val count = topics[course.id]\n   154\t                        course.id to if (count == null) (done[course.id]?.done ?: 0) to 0\n   155\t                            else count.completed to count.total\n   156\t                    }, rules)\n   157\t                }\n   158\t            }.distinctUntilChanged()\n   159\t\n   160\t    fun observeReminderCourses(): Flow<List<CourseEntity>> = dao.observeReminderCourses()\n   161\t\n   162\t    fun observeCategories(): Flow<List<CategoryEntity>> = dao.observeCategories()\n   163\t\n   164\t    suspend fun getCourse(courseId: String): CourseEntity? = dao.getCourse(courseId)\n   165\t\n   166\t    suspend fun getCourseDetails(courseId: String): CourseDetails? = database.withTransaction {\n   167\t        val course = dao.getCourse(courseId) ?: return@withTransaction null\n   168\t        CourseDetails(course, dao.getTopics(courseId),\n   169\t            dao.getCategories().find { it.id == course.categoryId }, dao.getSchedule(courseId) != null)\n   170\t    }\n   171\t\n   172\t    fun observeCourseDetails(courseId: String): Flow<CourseDetails?> =\n   173\t        database.invalidationTracker.createFlow(\"courses\", \"categories\", \"topics\", \"schedules\", \"schedule_rules\")\n   174\t            .map { getCourseDetails(courseId) }\n   175\t\n   176\t    /** Outer transaction includes metadata, category/color allocation and topic reconciliation. */\n   177\t    suspend fun saveCourseForm(\n   178\t        courseId: String? = null,\n   179\t        name: String,\n   180\t        colorId: Int?,\n   181\t        categoryName: String = \"\",\n   182\t        topicText: String? = null,\n   183\t    ): CourseEntity = database.withTransaction {\n   184\t        if (courseId == null) {\n   185\t            createCourse(name, colorId, categoryName,\n   186\t                TopicListEditor.parse(topicText.orEmpty()).map { it.title })\n   187\t        } else {\n   188\t            val updated = updateCourse(courseId, name, colorId, categoryName)\n   189\t            if (!updated.isCompleted && topicText != null) saveTopicList(courseId, topicText)\n   190\t            dao.getCourse(courseId)!!\n   191\t        }\n   192\t    }\n   193\t\n   194\t    suspend fun deleteCategory(categoryId: String, confirmed: Boolean = false) =\n   195\t        database.withTransaction {\n   196\t            if (dao.getCategories().none { it.id == categoryId }) fail(RepositoryError.CATEGORY_NOT_FOUND)\n   197\t            if (!confirmed && dao.countCoursesInCategory(categoryId) > 0) fail(RepositoryError.CATEGORY_IN_USE)\n   198\t            dao.deleteCategory(categoryId)\n   199\t        }\n   200\t\n   201\t    /** Returns the new completion state; no calendar row is created or rewritten. */\n   202\t    suspend fun toggleTopicCompletion(courseId: String, topicId: String): Boolean =\n   203\t        database.withTransaction {\n   204\t            val course = dao.getCourse(courseId) ?: fail(RepositoryError.COURSE_NOT_FOUND)\n   205\t            if (course.isCompleted) fail(RepositoryError.COURSE_COMPLETED)\n   206\t            val topic = dao.getTopic(topicId)\n   207\t            if (topic == null || topic.courseId != courseId) {\n   208\t                fail(RepositoryError.INVALID_TOPIC)\n   209\t            }\n   210\t            val completed = !topic.isCompleted\n   211\t            val timestamp = now()\n   212\t            dao.updateTopic(topic.copy(isCompleted = completed, completionDate = null))\n   213\t            dao.updateCourse(course.copy(updatedAt = timestamp))\n   214\t            operations.reconcileExhaustion(courseId)\n   215\t            completed\n   216\t        }\n   217\t\n   218\t    suspend fun getTopicEditorTopics(courseId: String): List<EditableTopic> =\n   219\t        database.withTransaction {\n   220\t            dao.getCourse(courseId) ?: fail(RepositoryError.COURSE_NOT_FOUND)\n   221\t            topicSnapshot(dao.getTopics(courseId))\n   222\t        }\n   223\t\n   224\t    /** Rebuild against current completion state; a stale draft cannot overwrite progress. */\n   225\t    suspend fun saveTopicList(courseId: String, text: String): List<TopicEntity> =\n   226\t        database.withTransaction {\n   227\t            val course = dao.getCourse(courseId) ?: fail(RepositoryError.COURSE_NOT_FOUND)\n   228\t            if (course.isCompleted) fail(RepositoryError.COURSE_COMPLETED)\n   229\t            val existing = dao.getTopics(courseId)\n   230\t            val snapshot = topicSnapshot(existing)\n   231\t            val plan = TopicListEditor.plan(text, snapshot)\n   232\t            val byId = existing.associateBy { it.id }\n   233\t            val timestamp = now()\n   234\t            var changed = false\n   235\t            plan.deletedIds.forEach { id ->\n   236\t                dao.deleteTopic(id)\n   237\t                changed = true\n   238\t            }\n   239\t            plan.topics.forEach { topic ->\n   240\t                val old = topic.existingId?.let { byId.getValue(it) }\n   241\t                if (old == null) {\n   242\t                    dao.insertTopic(TopicEntity(newId(), courseId, topic.position, topic.title))\n   243\t                    changed = true\n   244\t                } else {\n   245\t                    val updated = old.copy(position = topic.position, title = topic.title)\n   246\t                    if (updated != old) {\n   247\t                        dao.updateTopic(updated)\n   248\t                        changed = true\n   249\t                    }\n   250\t                }\n   251\t            }\n   252\t            if (changed) dao.updateCourse(course.copy(updatedAt = timestamp))\n   253\t            operations.reconcileExhaustion(courseId)\n   254\t            dao.getTopics(courseId)\n   255\t        }\n   256\t\n   257\t    private fun topicSnapshot(\n   258\t        topics: List<TopicEntity>,\n   259\t    ): List<EditableTopic> {\n   260\t        return topics.map {\n   261\t            EditableTopic(it.id, it.title, it.position, it.isCompleted)\n   262\t        }\n   263\t    }\n   264\t\n   265\t    suspend fun createCourse(\n   266\t        name: String,\n   267\t        colorId: Int?,\n   268\t        categoryName: String = \"\",\n   269\t        topics: List<String> = emptyList(),\n   270\t    ): CourseEntity = database.withTransaction {\n   271\t        val title = checkedCourseName(name)\n   272\t        checkColor(colorId)\n   273\t        val topicTitles = topics.map(TopicListEditor::normalizeTitle)\n   274\t        if (topicTitles.any { it.isEmpty() }) fail(RepositoryError.INVALID_TOPIC)\n   275\t        if (dao.countUnfinishedCourses() >= COLOR_COUNT) fail(RepositoryError.COURSE_LIMIT)\n   276\t        requireAvailableColor(colorId)\n   277\t        val categoryId = resolveCategory(categoryName)\n   278\t        val timestamp = now()\n   279\t        val course = CourseEntity(\n   280\t            id = newId(), name = title, colorId = colorId,\n   281\t            createdAt = timestamp, updatedAt = timestamp, categoryId = categoryId,\n   282\t        )\n   283\t        dao.insertCourse(course)\n   284\t        topicTitles.forEachIndexed { position, topicTitle ->\n   285\t            dao.insertTopic(TopicEntity(newId(), course.id, position, topicTitle))\n   286\t        }\n   287\t        course\n   288\t    }\n   289\t\n   290\t    suspend fun updateCourse(\n   291\t        courseId: String,\n   292\t        name: String,\n   293\t        colorId: Int?,\n   294\t        categoryName: String = \"\",\n   295\t    ): CourseEntity = database.withTransaction {\n   296\t        val existing = dao.getCourse(courseId) ?: fail(RepositoryError.COURSE_NOT_FOUND)\n   297\t        if (existing.isCompleted) fail(RepositoryError.COURSE_COMPLETED)\n   298\t        val title = checkedCourseName(name)\n   299\t        checkColor(colorId)\n   300\t        requireAvailableColor(colorId, courseId)\n   301\t        val updated = existing.copy(\n   302\t            name = title, colorId = colorId,\n   303\t            categoryId = resolveCategory(categoryName), updatedAt = now(),\n   304\t        )\n   305\t        dao.updateCourse(updated)\n   306\t        updated\n   307\t    }\n   308\t\n   309\t    /** Explicit shared-category rename, distinct from editing a course's category field. */\n   310\t    suspend fun renameCategory(categoryId: String, name: String): CategoryEntity =\n   311\t        database.withTransaction {\n   312\t            val title = checkedName(name)\n   313\t            val categories = dao.getCategories()\n   314\t            val existing = categories.find { it.id == categoryId }\n   315\t                ?: fail(RepositoryError.CATEGORY_NOT_FOUND)\n   316\t            if (categories.any { it.id != categoryId && sameCategoryName(it.name, title) }) {\n   317\t                fail(RepositoryError.CATEGORY_NAME_CONFLICT)\n   318\t            }\n   319\t            existing.copy(name = title).also { dao.updateCategory(it) }\n   320\t        }\n   321\t\n   322\t    suspend fun availableColors(courseId: String? = null): List<Int> =\n   323\t        database.withTransaction {\n   324\t            val course = courseId?.let {\n   325\t                dao.getCourse(it) ?: fail(RepositoryError.COURSE_NOT_FOUND)\n   326\t            }\n   327\t            if (course?.isCompleted == true) {\n   328\t                emptyList()\n   329\t            } else {\n   330\t                val occupied = dao.getCourses().filter { !it.isCompleted }\n   331\t                    .filter { it.id != courseId }.map { it.colorId }.toSet()\n   332\t                (0 until COLOR_COUNT).filterNot { it in occupied }\n   333\t            }\n   334\t        }\n   335\t\n   336\t    private suspend fun resolveCategory(name: String): String? {\n   337\t        val title = name.trim()\n   338\t        if (title.isEmpty()) return null\n   339\t        return dao.getCategories().find { sameCategoryName(it.name, title) }?.id\n   340\t            ?: CategoryEntity(newId(), title).also { dao.insertCategory(it) }.id\n   341\t    }\n   342\t\n   343\t    private suspend fun requireAvailableColor(colorId: Int?, courseId: String? = null) {\n   344\t        if (dao.getCourses().filter { !it.isCompleted }.any { it.colorId == colorId && it.id != courseId }) {\n   345\t            fail(RepositoryError.COLOR_UNAVAILABLE)\n   346\t        }\n   347\t    }\n   348\t\n   349\t    private fun checkedCourseName(name: String): String = checkedName(name).also {\n   350\t        if (it.codePointCount(0, it.length) > 50) fail(RepositoryError.NAME_TOO_LONG)\n   351\t    }\n   352\t\n   353\t    private fun checkedName(name: String): String = name.trim().also {\n   354\t        if (it.isEmpty()) fail(RepositoryError.EMPTY_NAME)\n   355\t    }\n   356\t\n   357\t    private fun checkColor(colorId: Int?) {\n   358\t        if (colorId == null || colorId !in 0 until COLOR_COUNT) fail(RepositoryError.INVALID_COLOR)\n   359\t    }\n   360\t\n     1\tpackage com.utbildning.tracker.data.local\n     2\t\n     3\timport com.utbildning.tracker.data.CourseTopicCounts\n     4\timport com.utbildning.tracker.data.CourseDoneCount\n     5\timport androidx.room.Dao\n     6\timport androidx.room.Insert\n     7\timport androidx.room.OnConflictStrategy\n     8\timport androidx.room.Query\n     9\timport androidx.room.Update\n    10\timport kotlinx.coroutines.flow.Flow\n    11\t\n    12\t/** Storage primitives. Business invariants belong to repository transactions. */\n    13\t@Dao\n    14\tinterface TrackerDao {\n    15\t    @Insert(onConflict = OnConflictStrategy.ABORT)\n    16\t    suspend fun insertCategory(category: CategoryEntity)\n    17\t\n    18\t    @Insert(onConflict = OnConflictStrategy.ABORT)\n    19\t    suspend fun insertCourse(course: CourseEntity)\n    20\t\n    21\t    @Insert(onConflict = OnConflictStrategy.ABORT)\n    22\t    suspend fun insertTopic(topic: TopicEntity)\n    23\t\n    24\t    @Insert(onConflict = OnConflictStrategy.ABORT)\n    25\t    suspend fun insertSchedule(schedule: ScheduleEntity)\n    26\t\n    27\t    @Insert(onConflict = OnConflictStrategy.ABORT)\n    28\t    suspend fun insertScheduleRule(rule: ScheduleRuleEntity)\n    29\t\n    30\t    @Insert(onConflict = OnConflictStrategy.ABORT)\n    31\t    suspend fun insertSessionRecord(session: SessionRecord)\n    32\t\n    33\t    suspend fun insertSession(session: SessionEntity) = insertSessionRecord(session.record())\n    34\t\n    35\t    @Update(onConflict = OnConflictStrategy.ABORT)\n    36\t    suspend fun updateCourse(course: CourseEntity)\n    37\t\n    38\t    @Update(onConflict = OnConflictStrategy.ABORT)\n    39\t    suspend fun updateCategory(category: CategoryEntity)\n    40\t\n    41\t    @Query(\"SELECT * FROM categories ORDER BY name, id\")\n    42\t    suspend fun getCategories(): List<CategoryEntity>\n    43\t\n    44\t    @Query(\"SELECT COUNT(*) FROM courses WHERE isCompleted = 0\")\n    45\t    suspend fun countUnfinishedCourses(): Int\n    46\t\n    47\t    @Query(\"SELECT COUNT(*) FROM courses WHERE categoryId = :categoryId\")\n    48\t    suspend fun countCoursesInCategory(categoryId: String): Int\n    49\t\n    50\t    @Query(\"DELETE FROM topics WHERE id = :id\")\n    51\t    suspend fun deleteTopic(id: String)\n    52\t\n    53\t    @Update(onConflict = OnConflictStrategy.ABORT)\n    54\t    suspend fun updateTopic(topic: TopicEntity)\n    55\t\n    56\t    @Update(onConflict = OnConflictStrategy.ABORT)\n    57\t    suspend fun updateSessionRecord(session: SessionRecord)\n    58\t\n    59\t    suspend fun updateSession(session: SessionEntity) = updateSessionRecord(session.record())\n    60\t\n    61\t    @Update(onConflict = OnConflictStrategy.ABORT)\n    62\t    suspend fun updateSchedule(schedule: ScheduleEntity)\n    63\t\n    64\t    @Query(\"SELECT * FROM courses ORDER BY createdAt, id\")\n    65\t    suspend fun getCourses(): List<CourseEntity>\n    66\t\n    67\t    @Query(\"SELECT * FROM courses WHERE isCompleted = 0 ORDER BY createdAt, id\")\n    68\t    suspend fun getUnfinishedCourses(): List<CourseEntity>\n    69\t\n    70\t    @Query(\"UPDATE sessions SET result = 'SKIPPED', updatedAt = :timestamp WHERE result = 'PENDING' AND date < :lastEditableDate\")\n    71\t    suspend fun skipExpiredPendingSessions(lastEditableDate: Long, timestamp: Long)\n    72\t\n    73\t    @Query(\"SELECT date FROM sessions WHERE courseId = :courseId AND date BETWEEN :firstDate AND :lastDate\")\n    74\t    suspend fun getSessionDatesBetween(courseId: String, firstDate: Long, lastDate: Long): List<Long>\n    75\t\n    76\t    @Query(\"SELECT courseId, SUM(CASE WHEN isCompleted = 1 THEN 1 ELSE 0 END) AS completed, COUNT(*) AS total FROM topics GROUP BY courseId\")\n    77\t    suspend fun getCourseTopicCounts(): List<CourseTopicCounts>\n    78\t\n    79\t    @Query(\"SELECT courseId, COUNT(*) AS done FROM sessions WHERE result = 'DONE' GROUP BY courseId\")\n    80\t    suspend fun getCourseDoneCounts(): List<CourseDoneCount>\n    81\t\n    82\t    @Query(\"SELECT * FROM schedule_rules ORDER BY courseId, dayOfWeek\")\n    83\t    suspend fun getAllScheduleRules(): List<ScheduleRuleEntity>\n    84\t\n    85\t    @Query(\"SELECT * FROM topics ORDER BY id\")\n    86\t    suspend fun getAllTopics(): List<TopicEntity>\n    87\t\n    88\t    @Query(\"SELECT * FROM schedules ORDER BY courseId\")\n    89\t    suspend fun getAllSchedules(): List<ScheduleEntity>\n    90\t\n    91\t\n    92\t    @Query(\"SELECT s.*, c.name AS courseName, c.colorId AS colorId, c.isCompleted AS courseCompleted FROM sessions s JOIN courses c ON c.id = s.courseId ORDER BY s.date, s.startMinute, s.id\")\n    93\t    suspend fun getAllSessions(): List<SessionEntity>\n    94\t\n    95\t    @Query(\"\"\"SELECT s.*, c.name AS courseName, c.colorId AS colorId, c.isCompleted AS courseCompleted\n    96\t        FROM sessions s JOIN courses c ON c.id = s.courseId\n    97\t        JOIN schedules schedule ON schedule.courseId = c.id\n    98\t        WHERE s.result = 'PENDING' AND s.date >= :earliestDate\n    99\t        AND c.isCompleted = 0 AND c.isPaused = 0\n   100\t        AND (NOT EXISTS(SELECT 1 FROM topics WHERE courseId = c.id)\n   101\t            OR EXISTS(SELECT 1 FROM topics WHERE courseId = c.id AND isCompleted = 0))\n   102\t        ORDER BY s.date, s.startMinute, s.id\"\"\")\n   103\t    suspend fun getReminderCandidates(earliestDate: Long): List<SessionEntity>\n   104\t\n   105\t    @Query(\"SELECT s.*, c.name AS courseName, c.colorId AS colorId, c.isCompleted AS courseCompleted FROM sessions s JOIN courses c ON c.id = s.courseId ORDER BY s.date, s.startMinute, s.id\")\n   106\t    fun observeSessions(): Flow<List<SessionEntity>>\n   107\t\n   108\t    @Query(\"SELECT s.*, c.name AS courseName, c.colorId AS colorId, c.isCompleted AS courseCompleted FROM sessions s JOIN courses c ON c.id = s.courseId WHERE s.date BETWEEN :firstDate AND :lastDate ORDER BY s.date, s.startMinute, s.id\")\n   109\t    fun observeSessionsBetween(firstDate: Long, lastDate: Long): Flow<List<SessionEntity>>\n   110\t\n   111\t    @Query(\"DELETE FROM sessions WHERE id = :id\")\n   112\t    suspend fun deleteSession(id: String)\n   113\t\n   114\t    @Query(\"SELECT * FROM courses WHERE id = :id\")\n   115\t    suspend fun getCourse(id: String): CourseEntity?\n   116\t\n   117\t    @Query(\"SELECT * FROM topics WHERE id = :id\")\n   118\t    suspend fun getTopic(id: String): TopicEntity?\n   119\t\n   120\t    @Query(\"SELECT s.*, c.name AS courseName, c.colorId AS colorId, c.isCompleted AS courseCompleted FROM sessions s JOIN courses c ON c.id = s.courseId WHERE s.id = :id\")\n   121\t    suspend fun getSession(id: String): SessionEntity?\n   122\t\n   123\t    @Query(\"SELECT EXISTS(SELECT 1 FROM topics WHERE courseId = :courseId) AND NOT EXISTS(SELECT 1 FROM topics WHERE courseId = :courseId AND isCompleted = 0)\")\n   124\t    suspend fun hasExhaustedTopics(courseId: String): Boolean\n   125\t\n   126\t    @Query(\"SELECT * FROM courses WHERE isCompleted = 0 AND isPaused = 0 AND (NOT EXISTS(SELECT 1 FROM topics WHERE courseId = courses.id) OR EXISTS(SELECT 1 FROM topics WHERE courseId = courses.id AND isCompleted = 0))\")\n   127\t    suspend fun getReminderCourses(): List<CourseEntity>\n   128\t\n   129\t    @Query(\"SELECT * FROM courses WHERE isCompleted = 0 AND isPaused = 0 AND (NOT EXISTS(SELECT 1 FROM topics WHERE courseId = courses.id) OR EXISTS(SELECT 1 FROM topics WHERE courseId = courses.id AND isCompleted = 0))\")\n   130\t    fun observeReminderCourses(): Flow<List<CourseEntity>>\n   131\t\n   132\t    @Query(\"SELECT * FROM topics WHERE courseId = :courseId ORDER BY position, id\")\n   133\t    suspend fun getTopics(courseId: String): List<TopicEntity>\n   134\t\n   135\t    @Query(\"SELECT s.*, c.name AS courseName, c.colorId AS colorId, c.isCompleted AS courseCompleted FROM sessions s JOIN courses c ON c.id = s.courseId WHERE s.courseId = :courseId ORDER BY s.date, s.startMinute, s.id\")\n   136\t    suspend fun getSessions(courseId: String): List<SessionEntity>\n   137\t\n   138\t    @Query(\"SELECT * FROM schedules WHERE courseId = :courseId\")\n   139\t    suspend fun getSchedule(courseId: String): ScheduleEntity?\n   140\t\n   141\t    @Query(\"SELECT * FROM schedule_rules WHERE courseId = :courseId ORDER BY dayOfWeek\")\n   142\t    suspend fun getScheduleRules(courseId: String): List<ScheduleRuleEntity>\n   143\t\n   144\t    @Query(\"DELETE FROM courses WHERE id = :id\")\n   145\t    suspend fun deleteCourse(id: String)\n   146\t\n   147\t    @Query(\"DELETE FROM categories WHERE id = :id\")\n   148\t    suspend fun deleteCategory(id: String)\n   149\t\n   150\t    @Query(\"DELETE FROM schedules WHERE courseId = :courseId\")\n   151\t    suspend fun deleteSchedule(courseId: String)\n   152\t\n   153\t    @Query(\"SELECT * FROM courses ORDER BY createdAt, id\")\n   154\t    fun observeCourses(): Flow<List<CourseEntity>>\n   155\t\n   156\t    @Query(\"SELECT * FROM categories ORDER BY name, id\")\n   157\t    fun observeCategories(): Flow<List<CategoryEntity>>\n   158\t\n   159\t    @Query(\"SELECT * FROM topics WHERE courseId = :courseId ORDER BY position, id\")\n   160\t    fun observeTopics(courseId: String): Flow<List<TopicEntity>>\n   161\t\n   162\t}\n     1\tpackage com.utbildning.tracker.data.local\n     2\t\n     3\timport androidx.room.Entity\n     4\timport androidx.room.ColumnInfo\n     5\timport androidx.room.ForeignKey\n     6\timport androidx.room.Index\n     7\timport androidx.room.PrimaryKey\n     8\t\n     9\tenum class SessionResult { PENDING, DONE, SKIPPED }\n    10\t\n    11\tprivate fun validateId(id: String) = require(id.isNotBlank())\n    12\tprivate fun validateTime(start: Int, end: Int?) {\n    13\t    require(start in 0..1439)\n    14\t    require(end == null || end in 0..1439)\n    15\t}\n    16\t\n    17\t@Entity(tableName = \"categories\")\n    18\tdata class CategoryEntity(@PrimaryKey val id: String, val name: String) {\n    19\t    init {\n    20\t        validateId(id)\n    21\t        require(name.isNotBlank())\n    22\t    }\n    23\t}\n    24\t\n    25\t@Entity(\n    26\t    tableName = \"courses\",\n    27\t    foreignKeys = [\n    28\t        ForeignKey(\n    29\t            entity = CategoryEntity::class,\n    30\t            parentColumns = [\"id\"],\n    31\t            childColumns = [\"categoryId\"],\n    32\t            onDelete = ForeignKey.SET_NULL,\n    33\t        ),\n    34\t    ],\n    35\t    indices = [\n    36\t        Index(\"categoryId\"),\n    37\t        Index(value = [\"colorId\"], unique = true, name = \"index_courses_active_color\"),\n    38\t    ],\n    39\t)\n    40\tdata class CourseEntity(\n    41\t    @PrimaryKey val id: String,\n    42\t    val name: String,\n    43\t    val colorId: Int?,\n    44\t    val createdAt: Long,\n    45\t    val updatedAt: Long,\n    46\t    val categoryId: String? = null,\n    47\t    val isCompleted: Boolean = false,\n    48\t    val isPaused: Boolean = false,\n    49\t    val completedAt: Long? = null,\n    50\t) {\n    51\t    init {\n    52\t        validateId(id)\n    53\t        require(name.isNotBlank())\n    54\t        require(colorId == null || colorId in 0..9)\n    55\t        categoryId?.let(::validateId)\n    56\t        require(isCompleted == (completedAt != null))\n    57\t        require(isCompleted == (colorId == null))\n    58\t    }\n    59\t}\n    60\t\n    61\t@Entity(\n    62\t    tableName = \"topics\",\n    63\t    foreignKeys = [\n    64\t        ForeignKey(\n    65\t            entity = CourseEntity::class,\n    66\t            parentColumns = [\"id\"],\n    67\t            childColumns = [\"courseId\"],\n    68\t            onDelete = ForeignKey.CASCADE,\n    69\t        ),\n    70\t    ],\n    71\t    indices = [\n    72\t        Index(valu