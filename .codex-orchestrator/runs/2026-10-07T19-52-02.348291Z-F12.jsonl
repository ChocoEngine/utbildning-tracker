             { model.showAll = !model.showAll }, { model.open(it) }, model.scheduleRules, model.topicPaces)\n    96\t        } else CourseEditorContent(draft, model.categories, model.colors, model.busy, model.error,\n    97\t            model::change, model::commitName, { model.leave() }, model::applyTopics, { model.removeCategory(it) }, model::toggle,\n    98\t            { model.openSchedule(onSchedule) }, model::requestLifecycle,\n    99\t            model::commitCategory, model::selectCategory, model::selectColor)\n   100\t        if (model.creating && draft != null) AlertDialog(onDismissRequest = model::cancel,\n   101\t            modifier = Modifier.imePadding().systemBarsPadding(),\n   102\t            properties = androidx.compose.ui.window.DialogProperties(decorFitsSystemWindows = false),\n   103\t            title = if (WindowInsets.ime.getBottom(androidx.compose.ui.platform.LocalDensity.current) > 0) null else ({ Text(stringResource(R.string.course_add)) }),\n   104\t            text = { Column(Modifier.verticalScroll(rememberScrollState()), verticalArrangement = Arrangement.spacedBy(12.dp)) {\n   105\t                CourseNameField(draft.name, { value -> model.change { it.copy(name = value) } },\n   106\t                    Modifier.fillMaxWidth().testTag(\"course_name\"))\n   107\t                CategoryField(draft.category, model.categories, { value -> model.change { it.copy(category = value) } },\n   108\t                    { value -> model.change { it.copy(category = value) } }, {}, { model.removeCategory(it) })\n   109\t                model.error?.let { Text(errorText(it), color = MaterialTheme.colorScheme.error, modifier = Modifier.testTag(\"course_error\")) }\n   110\t            } },\n   111\t            confirmButton = { Button(onClick = model::continueCreation, enabled = !model.busy, modifier = Modifier.testTag(\"course_continue\")) { Text(stringResource(R.string.course_continue)) } },\n   112\t            dismissButton = { TextButton(onClick = model::cancel, modifier = Modifier.testTag(\"course_cancel\")) { Text(stringResource(R.string.course_cancel)) } })\n   113\t        model.lifecycleAction?.let { action ->\n   114\t            AlertDialog(onDismissRequest = model::dismissLifecycle,\n   115\t                text = { Column { Text(stringResource(when(action) { \"delete\" -> R.string.course_confirm_delete; \"pause\" -> R.string.course_confirm_pause; \"disable_schedule\" -> R.string.course_confirm_disable_schedule; else -> R.string.course_confirm_complete })); model.error?.let { Text(errorText(it), color = MaterialTheme.colorScheme.error) } } },\n   116\t                confirmButton = { TextButton(onClick = model::confirmLifecycle, enabled = !model.busy, modifier = Modifier.testTag(\"course_action_confirm\")) { Text(stringResource(when(action) { \"delete\" -> R.string.course_delete; \"pause\" -> R.string.course_pause; \"disable_schedule\" -> R.string.course_disable_schedule; else -> R.string.course_complete })) } },\n   117\t                dismissButton = { TextButton(onClick = model::dismissLifecycle, modifier = Modifier.testTag(\"course_action_cancel\")) { Text(stringResource(R.string.course_cancel)) } })\n   118\t        }\n   119\t        model.deleteCategory?.let { category ->\n   120\t            AlertDialog(onDismissRequest = model::dismissCategoryDelete,\n   121\t                text = { Column { Text(stringResource(R.string.category_delete_question, category.name)); model.error?.let { Text(errorText(it), color = MaterialTheme.colorScheme.error) } } },\n   122\t                confirmButton = { TextButton(onClick = { model.removeCategory(category, true) }, modifier = Modifier.testTag(\"category_delete_confirm\")) { Text(stringResource(R.string.course_delete)) } },\n   123\t                dismissButton = { TextButton(onClick = model::dismissCategoryDelete, modifier = Modifier.testTag(\"category_delete_cancel\")) { Text(stringResource(R.string.course_cancel)) } })\n   124\t        }\n   125\t    }\n   126\t}\n   127\t\n   128\t@Composable\n   129\tinternal fun CourseListContent(courses: List<CourseEntity>, categories: List<CategoryEntity>,\n   130\t    progress: Map<String, Pair<Int, Int>>, showAll: Boolean, onFilter: () -> Unit, onOpen: (String?) -> Unit,\n   131\t    scheduleRules: Map<String, List<ScheduleRuleEntity>> = emptyMap(),\n   132\t    topicPaces: Map<String, Int> = emptyMap()) {\n   133\t    val locale = LocalConfiguration.current.locales[0]\n   134\t    Column(Modifier.fillMaxSize().padding(horizontal = 22.dp), verticalArrangement = Arrangement.spacedBy(18.dp)) {\n   135\t        if (courses.count { !it.isCompleted } < 10) BoxWithConstraints(Modifier.fillMaxWidth()) {\n   136\t            // Same width as one of the three course actions: (screen width - 32 dp - 12 dp) / 3.\n   137\t            CourseActionButton(onClick = { onOpen(null) }, modifier = Modifier.width(maxWidth / 3).testTag(\"course_add\")) {\n   138\t                Text(stringResource(R.string.course_add), maxLines = 1)\n   139\t            }\n   140\t        }\n   141\t        val shown = courses.filter { showAll || !it.isCompleted }\n   142\t        Column(Modifier.weight(1f).fillMaxWidth().verticalScroll(rememberScrollState()).testTag(\"course_list_scroll\"), verticalArrangement = Arrangement.spacedBy(18.dp)) {\n   143\t            if (shown.isEmpty()) Text(stringResource(R.string.courses_empty), color = MaterialTheme.colorScheme.onSurfaceVariant)\n   144\t            shown.groupBy { it.categoryId }.forEach { (categoryId, group) ->\n   145\t                Column {\n   146\t                    Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(10.dp)) {\n   147\t                        Text((categories.find { it.id == categoryId }?.name ?: stringResource(R.string.course_no_category)).uppercase(locale),\n   148\t                            style = MaterialTheme.typography.labelMedium.copy(letterSpacing = 1.3.sp), color = MaterialTheme.colorScheme.onSurfaceVariant,\n   149\t                            modifier = Modifier.padding(vertical = 6.dp).widthIn(max = LocalConfiguration.current.screenWidthDp.dp - 84.dp))\n   150\t                        HorizontalDivider(Modifier.weight(1f), color = MaterialTheme.colorScheme.outlineVariant)\n   151\t                    }\n   152\t                    group.sortedBy { it.isCompleted }.forEachIndexed { index, course ->\n   153\t                        Surface(onClick = { onOpen(course.id) }, modifier = Modifier.fillMaxWidth().testTag(\"course_row_${course.id}\"), color = MaterialTheme.colorScheme.surface) {\n   154\t                            Row(Modifier.heightIn(min = 76.dp).padding(vertical = 16.dp), horizontalArrangement = Arrangement.spacedBy(12.dp)) {\n   155\t                                if (course.isCompleted) Text(\"✓\", modifier = Modifier.width(22.dp).padding(top = 3.dp))\n   156\t                                else CourseBlot(course.colorId, Modifier.padding(top = 3.dp).size(22.dp, 24.dp).alpha(if (course.isPaused) .45f else 1f))\n   157\t                                Column(Modifier.weight(1f)) {\n   158\t                                    Text(course.name, style = MaterialTheme.typography.titleMedium, color = if (course.isPaused)\n   159\t                                        lerp(MaterialTheme.colorScheme.onSurface, MaterialTheme.colorScheme.onSurfaceVariant, .65f) else MaterialTheme.colorScheme.onSurface)\n   160\t                                    val count = progress[course.id] ?: (0 to 0)\n   161\t                                    val rules = scheduleRules[course.id].orEmpty()\n   162\t                                    val schedule = rules.takeIf { it.isNotEmpty() }\n   163\t                                        ?.sortedBy { it.dayOfWeek }\n   164\t                                        ?.groupBy { it.startMinute }\n   165\t                                        ?.entries\n   166\t                                        ?.joinToString(\" · \") { (minute, days) ->\n   167\t                                            days.joinToString(\", \") { DayOfWeek.of(it.dayOfWeek).getDisplayName(TextStyle.SHORT, locale) } +\n   168\t                                                \" · \" + String.format(locale, \"%02d:%02d\", minute / 60, minute % 60)\n   169\t                                        }\n   170\t                                    val status = when {\n   171\t                                        course.isCompleted -> stringResource(R.string.course_finished_status)\n   172\t                                        course.isPaused -> stringResource(R.string.course_paused_status)\n   173\t                                        schedule == null -> stringResource(R.string.course_unscheduled)\n   174\t                                        else -> schedule\n   175\t                                    }\n   176\t                                    val percent = if (count.second > 0) kotlin.math.round(count.first * 100f / count.second).toInt() else 0\n   177\t                                    val pace = topicPaces[course.id]?.takeIf {\n   178\t                                        !course.isCompleted && !course.isPaused && rules.isNotEmpty() && count.first < count.second\n   179\t                                    }?.let { pluralStringResource(R.plurals.course_topic_pace, it, it) }\n   180\t                                    Row(Modifier.fillMaxWidth().padding(top = 4.dp, bottom = if (count.second > 0 && !course.isCompleted) 8.dp else 0.dp), horizontalArrangement = Arrangement.spacedBy(8.dp)) {\n   300\t            onDismissRequest = { paletteExpanded = false },\n   301\t            title = { Text(stringResource(R.string.course_color_label)) },\n   302\t            text = { FlowRow(horizontalArrangement = Arrangement.spacedBy(8.dp)) {\n   303\t            colors.forEach { color ->\n   304\t                val description = stringResource(R.string.course_color_number, color + 1)\n   305\t                Box(Modifier.size(44.dp).background(if (draft.color == color) MaterialTheme.colorScheme.surfaceVariant else androidx.compose.ui.graphics.Color.Transparent, RoundedCornerShape(12.dp)).combinedClickable(onClick = { focus.clearFocus(); onColorSelected(color); paletteExpanded = false })\n   306\t                    .semantics { contentDescription = description; selected = draft.color == color; role = Role.RadioButton }.testTag(\"color_$color\"), contentAlignment = Alignment.Center) {\n   307\t                    CourseBlot(color, Modifier.size(27.dp, 28.dp))\n   308\t                    if (draft.color == color) Icon(painterResource(R.drawable.ic_check), null, Modifier.size(16.dp))\n   309\t                }\n   310\t            }\n   311\t        } },\n   312\t            confirmButton = { TextButton(onClick = { paletteExpanded = false }) { Text(stringResource(R.string.course_cancel)) } })\n   313\t        TextButton(onClick = { categoryOpen = true }, enabled = !draft.completed, modifier = Modifier.testTag(\"course_category_open\")) {\n   314\t            Text(if (draft.category.isBlank()) stringResource(R.string.course_add_category) else \"${stringResource(R.string.course_category)}: ${draft.category} ⌄\")\n   315\t        }\n   316\t        if (categoryOpen) AlertDialog(onDismissRequest = { focus.clearFocus(); onCategoryCommit(); categoryOpen = false },\n   317\t            modifier = Modifier.imePadding().systemBarsPadding(),\n   318\t            properties = androidx.compose.ui.window.DialogProperties(decorFitsSystemWindows = false),\n   319\t            text = { CategoryField(draft.category, categories, { value -> onChange { it.copy(category = value) } }, { value -> onCategorySelected(value); categoryOpen = false }, onCategoryCommit, onDeleteCategory) },\n   320\t            confirmButton = { TextButton(onClick = { focus.clearFocus(); onCategoryCommit(); categoryOpen = false }) { Text(stringResource(R.string.topics_apply)) } })\n   321\t        if (!draft.completed && !draft.paused) {\n   322\t            val locale = LocalConfiguration.current.locales[0]\n   323\t            CourseSectionDivider()\n   324\t            Row(Modifier.fillMaxWidth().combinedClickable(onClick = { draft.id?.let { focus.clearFocus(); onSchedule(it) } }, enabled = !busy && draft.id != null).testTag(\"course_schedule_row\"), verticalAlignment = Alignment.CenterVertically,\n   325\t                horizontalArrangement = Arrangement.spacedBy(8.dp)) {\n   326\t                if (draft.id != null && !draft.completed) IconButton(\n   327\t                    onClick = { focus.clearFocus(); onSchedule(draft.id) },\n   328\t                    enabled = !busy, modifier = Modifier.testTag(\"course_schedule\")) {\n   329\t                    Icon(painterResource(R.drawable.ic_calendar),\n   330\t                        stringResource(if (draft.hasSchedule) R.string.course_configure else R.string.course_enable_schedule),\n   331\t                        Modifier.size(20.dp))\n   332\t                } else Icon(painterResource(R.drawable.ic_calendar), null, Modifier.size(20.dp))\n   333\t                if (draft.rules.isEmpty()) Text(stringResource(R.string.course_unscheduled),\n   334\t                    style = MaterialTheme.typography.bodyMedium)\n   335\t                else FlowRow(Modifier.weight(1f), horizontalArrangement = Arrangement.spacedBy(8.dp),\n   336\t                    verticalArrangement = Arrangement.spacedBy(6.dp)) {\n   337\t                    draft.rules.sortedBy { it.dayOfWeek }.groupBy { it.startMinute to it.endMinute }.forEach { (times, rules) ->\n   338\t                        val days = rules.joinToString(\", \") { DayOfWeek.of(it.dayOfWeek).getDisplayName(TextStyle.SHORT, locale) }\n   339\t                        fun time(minute: Int) = java.time.LocalTime.of(minute / 60, minute % 60).toString()\n   340\t                        val hours = time(times.first) + (times.second?.let { \"–\" + time(it) } ?: \"\")\n   341\t                        Text(\"$days  $hours\",\n   342\t                            Modifier.background(MaterialTheme.colorScheme.surfaceVariant, RoundedCornerShape(9.dp)).padding(8.dp),\n   343\t                            style = MaterialTheme.typography.bodySmall)\n   344\t                    }\n   345\t                }\n   346\t            }\n   347\t            if (draft.hasSchedule) draft.endsOn?.let { end ->\n   348\t                Text(stringResource(R.string.course_schedule_until,\n   349\t                    java.time.LocalDate.ofEpochDay(end).format(java.time.format.DateTimeFormatter.ofLocalizedDate(java.time.format.FormatStyle.MEDIUM).withLocale(locale))),\n   350\t                    style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurfaceVariant)\n   351\t            }\n   352\t            CourseSectionDivider()\n   353\t        }\n   354\t        val completed = draft.topics.filter { it.isCompleted }\n   355\t        val total = completed.size + TopicListEditor.parse(draft.text).size\n   356\t        Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween, verticalAlignment = Alignment.CenterVertically) {\n   357\t            Row(verticalAlignment = Alignment.CenterVertically) {\n   358\t                Text(stringResource(R.string.course_topics), style = MaterialTheme.typography.titleLarge)\n   359\t                if (!draft.completed && draft.editingText == null) IconButton(\n   360\t                    onClick = { onChange { it.copy(editingText = it.text) } },\n   361\t                    modifier = Modifier.testTag(\"topics_edit\")) {\n   362\t                    Icon(painterResource(R.drawable.ic_edit), stringResource(R.string.topics_edit), Modifier.size(20.dp))\n   363\t                }\n   364\t            }\n   365\t            if (total > 0) Text(stringResource(R.string.course_topics_progress, completed.size, total), style = MaterialTheme.typography.bodySmall)\n   366\t        }\n   367\t        if (total > 0) {\n   368\t            LinearProgressIndicator(progress = { completed.size.toFloat() / total }, color = courseColor(draft.color), trackColor = courseColor(draft.color).copy(alpha = .16f), modifier = Modifier.fillMaxWidth())\n   369\t        }\n   370\t\n   371\t        Column(Modifier.weight(1f).fillMaxWidth().padding(vertical = 6.dp).verticalScroll(rememberScrollState()).testTag(\"course_topics_scroll\")) {\n   372\t            draft.topics.sortedBy { it.position }.forEachIndexed { index, topic ->\n   373\t                TopicStatusRow(\n   374\t                    topic.id,\n   375\t                    topic.title,\n   376\t                    \"${index + 1}.\",\n   377\t                    topic.isCompleted,\n   378\t                    Modifier.combinedClickable(\n   379\t                        onClick = {},\n   380\t                        onLongClick = if (!draft.completed) ({ onToggle(topic.id) }) else null,\n   381\t                    ).testTag(\"topic_${topic.id}\"),\n   382\t                )\n   383\t                if (index < draft.topics.lastIndex) TopicStatusDivider()\n   384\t            }\n   385\t        }\n   386\t        if (draft.id != null && draft.editingText == null) {\n   387\t            CourseSectionDivider()\n   388\t            Text(stringResource(R.string.course_actions_label), style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurfaceVariant)\n   389\t            Row(Modifier.fillMaxWidth().padding(top = 6.dp).height(48.dp).testTag(\"course_actions\"), horizontalArrangement = Arrangement.spacedBy(6.dp)) {\n   390\t                if (!draft.completed) {\n   391\t                    CourseActionButton(onClick = { focus.clearFocus(); onLifecycle(\"complete\") },\n   392\t                        enabled = !busy,\n   393\t                        modifier = Modifier.weight(1f).testTag(\"course_complete\")) {\n   394\t                        Text(stringResource(R.string.course_complete_short), maxLines = 1)\n   395\t                    }\n   396\t                    if (draft.paused) CourseActionButton(onClick = { focus.clearFocus(); onLifecycle(\"resume\") }, enabled = !busy, modifier = Modifier.weight(1f).testTag(\"course_resume\")) { Text(stringResource(R.string.course_resume), maxLines = 1) }\n   397\t                    if (!draft.paused) CourseActionButton(\n   398\t                        onClick = { focus.clearFocus(); onLifecycle(\"pause\") },\n   399\t                        enabled = !busy,\n   400\t                        modifier = Modifier.weight(1f).testTag(\"course_pause\")) {\n   401\t                        Text(stringResource(R.string.course_pause_short), maxLines = 1)\n   402\t                    }\n   403\t                }\n   404\t                CourseActionButton(onClick = { focus.clearFocus(); onLifecycle(\"delete\") },\n   405\t                    enabled = !busy,\n   406\t                    modifier = Modifier.weight(1f).testTag(\"course_delete\")) {\n   407\t                    Text(stringResource(R.string.course_delete), maxLines = 1)\n   408\t                }\n   409\t            }\n   410\t        }\n   411\t        if (draft.editingText != null && !draft.completed) {\n   412\t            AlertDialog(onDismissRequest = { onChange { it.copy(editingText = null) } },\n   413\t                modifier = Modifier.imePadding().systemBarsPadding(),\n   414\t                properties = androidx.compose.ui.window.DialogProperties(decorFitsSystemWindows = false),\n   415\t                title = { Text(stringResource(R.string.topics_edit)) },\n   416\t                text = {\n   417\t                    Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {\n   418\t                        OutlinedTextField(draft.editingText, { value -> onChange { it.copy(editingText = value) } },\n   419\t                            label = { Text(stringResource(R.string.course_pending_topics)) },\n   