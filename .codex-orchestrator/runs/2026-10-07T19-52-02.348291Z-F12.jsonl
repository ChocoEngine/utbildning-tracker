e,\n   452\t        onValueChange = { candidate ->\n   453\t            if (candidate.text.codePointCount(0, candidate.text.length) <= 50) {\n   454\t                fieldValue = candidate\n   455\t                tooLong = false\n   456\t                onAccepted(candidate.text)\n   457\t            } else {\n   458\t                tooLong = true\n   459\t            }\n   460\t        },\n   461\t        label = { Text(stringResource(R.string.course_name)) },\n   462\t        singleLine = true,\n   463\t        isError = tooLong,\n   464\t        supportingText = {\n   465\t            Text(\n   466\t                if (tooLong) stringResource(R.string.course_name_too_long)\n   467\t                else \"${fieldValue.text.codePointCount(0, fieldValue.text.length)}/50\",\n   468\t                modifier = if (tooLong) Modifier.testTag(\"course_name_length_error\") else Modifier,\n   469\t            )\n   470\t        },\n   471\t        modifier = modifier,\n   472\t    )\n   473\t}\n   474\t\n   475\t@OptIn(ExperimentalMaterial3Api::class)\n   476\t@Composable\n   477\tprivate fun CategoryField(value: String, categories: List<CategoryEntity>, onChange: (String) -> Unit,\n   478\t    onSelect: (String) -> Unit, onCommit: () -> Unit, onDelete: (CategoryEntity) -> Unit) {\n   479\t    var expanded by remember { mutableStateOf(false) }\n   480\t    var focused by remember { mutableStateOf(false) }\n   481\t    val categoryLabel = stringResource(R.string.course_category)\n   482\t    var fieldWidth by remember { mutableStateOf(0.dp) }\n   483\t    val density = androidx.compose.ui.platform.LocalDensity.current\n   484\t    val matches = categories.filter { it.name.contains(value.trim(), true) }\n   485\t    val visible = expanded && matches.isNotEmpty()\n   486\t    Column(verticalArrangement = Arrangement.spacedBy(7.dp)) {\n   487\t        Text(stringResource(R.string.course_category), style = MaterialTheme.typography.bodySmall,\n   488\t            color = Mater