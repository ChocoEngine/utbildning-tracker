pp/app/src/main/res/values/strings.xml:52:    <string name=\"restore_confirm_message\">The backup is valid. Current data will be fully replaced; copies cannot be merged.</string>\ntracker-app/app/src/main/res/values/strings.xml:53:    <string name=\"restore_confirm\">Replace and restore</string>\ntracker-app/app/src/main/res/values/strings.xml:54:    <string name=\"restore_cancel\">Cancel</string>\ntracker-app/app/src/main/res/values/strings.xml:55:    <string name=\"restore_success\">Backup restored</string>\ntracker-app/app/src/main/res/values/strings.xml:56:    <string name=\"restore_cancelled\">Restore canceled. Current data was not changed.</string>\ntracker-app/app/src/main/res/values/strings.xml:57:    <string name=\"restore_invalid\">This backup file is invalid or cannot be read. Current data was not changed.</string>\ntracker-app/app/src/main/res/values/strings.xml:58:    <string name=\"restore_error\">Could not finish restoring. Your current or restored data remains safe; restart the app to finish if needed.</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:13:    <string name=\"retention_title\">История календаря</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:14:    <string name=\"retention_explanation\">Для всех курсов сохраняются сегодня и выбранное число предыдущих календарных дней. Занятия раньше этой границы по локальной дате удаляются при очистке независимо от состояния курса и времени его последнего изменения.</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:15:    <string name=\"retention_current\">Хранить последние %1$d дней и сегодня</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:16:    <string name=\"retention_disabled\">Очистка выключена: хранить все занятия</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:17:    <string name=\"retention_configure\">Настроить срок хранения</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:18:    <string name=\"retention_dialog_title\">Срок хранения календаря</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:19:    <string name=\"retention_dialog_explanation\">По умолчанию — 365 дней. Выберите от 1 до 3650 дней или выключите очистку, чтобы хранить все занятия.</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:20:    <string name=\"retention_cleanup_enabled\">Удалять старые занятия</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:21:    <string name=\"retention_days_label\">Сколько предыдущих дней хранить</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:22:    <string name=\"retention_range\">От 1 до 3650 дней</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:23:    <string name=\"retention_invalid\">Введите целое число от 1 до 3650</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:24:    <string name=\"retention_disabled_explanation\">Все занятия календаря будут храниться, пока очистка снова не будет включена.</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:25:    <string name=\"retention_save\">Сохранить</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:26:    <string name=\"retention_cancel\">Отмена</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:27:    <string name=\"retention_warning_title\">Хранить меньше занятий?</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:28:    <string name=\"retention_warning_message\">При ближайшей очистке будет удалено больше старых записей: занятия раньше локальной границы для последних %1$d дней будут удалены.</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:29:    <string name=\"retention_warning_confirm\">Хранить меньше</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:30:    <string name=\"backup_title\">Резервная копия</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:31:    <string name=\"backup_explanation\">Сохраните все курсы, темы, историю, расписания и язык в одном файле.</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:32:    <string name=\"backup_create\">Создать копию</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:33:    <string name=\"backup_creating\">Создание копии…</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:34:    <string name=\"backup_success\">Копия создана</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:35:    <string name=\"backup_cancelled\">Создание копии отменено</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:36:    <string name=\"backup_error\">Не удалось создать копию</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:37:    <string name=\"automatic_backup_title\">Еженедельная копия</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:38:    <string name=\"automatic_backup_explanation\">Android создаёт новый файл примерно раз в неделю, когда позволяют фоновые условия. Точное время не гарантируется. Прежние успешные файлы сохраняются.</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:39:    <string name=\"automatic_backup_enabled\">Еженедельная копия включена</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:40:    <string name=\"automatic_backup_disabled\">Еженедельная копия выключена</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:41:    <string name=\"automatic_backup_choose_folder\">Выбрать папку</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:42:    <string name=\"automatic_backup_change_folder\">Сменить папку</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:43:    <string name=\"automatic_backup_folder_selected\">Папка для копий выбрана</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:44:    <string name=\"automatic_backup_last_success\">Последняя успешная копия: %1$s</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:45:    <string name=\"automatic_backup_last_error\">Последняя попытка не удалась: %1$s. Проверьте доступ к выбранной папке или выберите другое хранилище.</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:46:    <string name=\"restore_title\">Восстановление</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:47:    <string name=\"restore_explanation\">Выберите файл копии. Восстановление полностью заменит текущие курсы, темы, расписания, историю и язык.</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:48:    <string name=\"restore_choose\">Выбрать копию</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:49:    <string name=\"restore_checking\">Проверка копии…</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:50:    <string name=\"restore_restoring\">Восстановление…</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:51:    <string name=\"restore_confirm_title\">Заменить все данные трекера?</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:52:    <string name=\"restore_confirm_message\">Копия прошла проверку. Текущие данные будут полностью заменены; объединить копии нельзя.</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:53:    <string name=\"restore_confirm\">Заменить и восстановить</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:54:    <string name=\"restore_cancel\">Отмена</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:55:    <string name=\"restore_success\">Копия восстановлена</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:56:    <string name=\"restore_cancelled\">Восстановление отменено. Текущие данные не изменены.</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:57:    <string name=\"restore_invalid\">Файл копии повреждён или недоступен. Текущие данные не изменены.</string>\ntracker-app/app/src/main/res/values-ru/strings.xml:58:    <string name=\"restore_error\">Не удалось завершить восстановление. Текущие или восстановленные данные сохранены; при необходимости перезапустите приложение.</string>\ntracker-app/app/src/main/java/com/utbildning/tracker/ui/guide/GuideScreen.kt:1:package com.utbildning.tracker.ui.guide\ntracker-app/app/src/main/java/com/utbildning/tracker/ui/guide/GuideScreen.kt:19:        Text(stringResource(R.string.guide_title), style = MaterialTheme.typography.headlineMedium)\ntracker-app/app/src/main/java/com/utbildning/tracker/ui/guide/GuideScreen.kt:20:        listOf(R.string.guide_courses, R.string.guide_categories, R.string.guide_topics, R.string.guide_gestures,\ntracker-app/app/src/main/java/com/utbildning/tracker/ui/guide/GuideScreen.kt:21:            R.string.guide_schedule, R.string.guide_results, R.string.guide_calendar, R.string.guide_retention, R.string.guide_lifecycle,\ntracker-app/app/src/main/java/com/utbildning/tracker/ui/guide/GuideScreen.kt:22:            R.string.guide_notifications, R.string.guide_backup)\npackage com.utbildning.tracker.ui.guide\n\nimport androidx.compose.foundation.layout.*\nimport androidx.compose.foundation.rememberScrollState\nimport androidx.compose.foundation.verticalScroll\nimport androidx.compose.material3.*\nimport androidx.compose.runtime.Composable\nimport androidx.compose.ui.Modifier\nimport androidx.compose.ui.res.stringResource\nimport androidx.compose.ui.tooling.preview.Preview\nimport androidx.compose.ui.unit.dp\nimport com.utbildning.tracker.R\nimport com.utbildning.tracker.ui.theme.TrackerTheme\n\n@Composable\ninternal fun GuideScreen(onBack: () -> Unit) {\n    Column(Modifier.fillMaxSize().verticalScroll(rememberScrollState()).padding(20.dp), verticalArrangement = Arrangement.spacedBy(16.dp)) {\n        TextButton(onClick = onBack) { Text(stringResource(R.string.back)) }\n        Text(stringResource(R.string.guide_title), style = MaterialTheme.typography.headlineMedium)\n        listOf(R.string.guide_courses, R.string.guide_categories, R.string.guide_topics, R.string.guide_gestures,\n            R.string.guide_schedule, R.string.guide_results, R.string.guide_calendar, R.string.guide_retention, R.string.guide_lifecycle,\n            R.string.guide_notifications, R.string.guide_backup)\n            .forEach { Text(stringResource(it), style = MaterialTheme.typography.bodyLarge) }\n    }\n}\n\n@Preview(locale = \"ru\", showBackground = true)\n@Composable\nprivate fun GuidePreview() { TrackerTheme { Surface { GuideScreen({}) } } }\n","exit_code":0,"status":"completed"}}
