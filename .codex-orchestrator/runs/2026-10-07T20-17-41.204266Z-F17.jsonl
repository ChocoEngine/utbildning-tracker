   try {\n    88\t                        val now = ZonedDateTime.now().withSecond(0).withNano(0)\n    89\t                        repo.saveInitialSchedule(course.id, listOf(WeeklyRule(now.plusDays(2).dayOfWeek.value, 720)))\n    90\t                        val date = now.toLocalDate().minusDays(if (yesterday) 1 else 0)\n    91\t                        val minute = now.hour * 60 + now.minute\n    92\t                        val id = \"shade_${UUID.randomUUID()}\"\n    93\t                        // Yesterday's question uses an overnight end; today's starts one minute earlier.\n    94\t                        val start = if (yesterday) minute + 1 else minute - 1\n    95\t                        assertTrue(\"Run away from midnight\", minute in 2..1437)\n    96\t                        val created = System.currentTimeMillis()\n    97\t                        dao.insertSession(SessionEntity(id, course.id, date.toEpochDay(), start,\n    98\t                            course.name, course.colorId, created, created, endMinute = minute))\n    99\t                        val topics = dao.getTopics(course.id)\n   100\t                        for (result in listOf(SessionResult.DONE, SessionResult.SKIPPED)) {\n   101\t                            assertEquals(\"App language before $result ${course.name}\", language, locales.applicationLocales[0].language)\n   102\t                            assertEquals(\"Resource language before $result ${course.name}\", language, context.resources.configuration.locales[0].language)\n   103\t                            // A fresh ID is required because delivery deduplication is durable.\n   104\t                            val actionId = if (result == SessionResult.DONE) id else \"shade_${UUID.randomUUID()}\"\n   105\t                            if (actionId != id) dao.insertSession(SessionEntity(actionId, course.id, date.toEpochDay(), start + if (yesterday) 1 else -1,\n   106\t                                course.name, course.colorId, created, created, endMinute = minute))\n   107\t                            ReminderScheduler.receive(context, now.toInstant().toEpochMilli(), repo)\n   108\t                            assertTrue(manager.activeNotifications.any { it.tag == actionId })\n   109\t                            shell(\"cmd statusbar expand-notifications\")\n   110\t                            automation.waitForIdle(300, 5_000)\n   111\t                            clickSystemText(if (language == \"ru\") {\n   112\t                                if (result == SessionResult.DONE) \"Пройдено\" else \"Пропущено\"\n   113\t                            } else if (result == SessionResult.DONE) \"Done\" else \"Skipped\")\n   114\t                            shell(\"cmd statusbar collapse\")\n   115\t                            if (result == SessionResult.DONE && withTopics) {\n   116\t                                assertEquals(SessionResult.PENDING, dao.getSession(actionId)!!.result)\n   117\t                                clickSystemText(\"First topic\")\n   118\t                                automation.waitForIdle(300, 5_000)\n   119\t                                clickSystemText(if (language == \"ru\") \"Пройдено\" else \"Done\")\n   120\t                            }\n   121\t                            val resultDeadline = System.currentTimeMillis() + 10_000\n   122\t                            while (dao.getSession(actionId)!!.result != result && System.currentTimeMillis() < resultDeadline) delay(50)\n   123\t                            assertEquals(\"${course.name} $actionId\", result, dao.getSession(actionId)!!.result)\n   124\t                            val cancelDeadline = System.currentTimeMillis() + 5_000\n   125\t                            while (manager.activeNotifications.any { it.tag == actionId } && System.currentTimeMillis() < cancelDeadline) delay(50)\n   126\t                            assertTrue(manager.activeNotifications.none { it.tag == actionId })\n   127\t          