n:945:  \"/sdcard/Pictures/TrackerChecks/ru_guide_320dp (19).png\",\ndocs/checks/r05/logs/media-before.json:984:  \"/sdcard/Pictures/TrackerChecks/en_guide_320dp (20).png\",\ndocs/checks/r05/logs/media-before.json:995:  \"/sdcard/Pictures/TrackerChecks/ru_guide_320dp (20).png\",\ndocs/checks/r05/logs/media-before.json:1034:  \"/sdcard/Pictures/TrackerChecks/en_guide_320dp (21).png\",\ndocs/checks/r05/logs/media-before.json:1045:  \"/sdcard/Pictures/TrackerChecks/ru_guide_320dp (21).png\",\ndocs/checks/r05/logs/media-before.json:1118:  \"/sdcard/Pictures/TrackerChecks/en_guide_320dp (22).png\",\ndocs/checks/r05/logs/media-before.json:1129:  \"/sdcard/Pictures/TrackerChecks/ru_guide_320dp (22).png\",\ndocs/checks/r05/logs/media-before.json:1168:  \"/sdcard/Pictures/TrackerChecks/en_guide_320dp (23).png\",\ndocs/checks/r05/logs/media-before.json:1179:  \"/sdcard/Pictures/TrackerChecks/ru_guide_320dp (23).png\",\ndocs/checks/r05/logs/media-before.json:1218:  \"/sdcard/Pictures/TrackerChecks/en_guide_320dp (24).png\",\ndocs/checks/r05/logs/media-before.json:1229:  \"/sdcard/Pictures/TrackerChecks/ru_guide_320dp (24).png\",\ndocs/checks/r05/logs/media-before.json:1275:  \"/sdcard/Pictures/TrackerChecks/en_guide_320dp_92b8a9b5-bf48-4177-9f8a-19a5628f040f.png\",\ndocs/checks/r05/logs/media-before.json:1286:  \"/sdcard/Pictures/TrackerChecks/ru_guide_320dp_8370e601-a6e1-4305-8f5d-f6ed947eb1f9.png\",\ndocs/checks/r05/logs/media-before.json:1355:  \"/sdcard/Pictures/TrackerChecks/en_guide_320dp_60352eac-afda-4b85-9d6e-84fde35493a1.png\",\ndocs/checks/r05/logs/media-before.json:1366:  \"/sdcard/Pictures/TrackerChecks/ru_guide_320dp_4a823cd6-311e-4678-a3c0-61d78a630219.png\",\ndocs/checks/r05/logs/media-before.json:1405:  \"/sdcard/Pictures/TrackerChecks/en_guide_320dp_bd90573a-1ced-4a47-a2aa-c2b47230ffee.png\",\ndocs/checks/r05/logs/media-before.json:1416:  \"/sdcard/Pictures/TrackerChecks/ru_guide_320dp_debd6c5d-f665-4285-9677-5491a73dd994.png\",\ndocs/checks/r05/logs/media-co