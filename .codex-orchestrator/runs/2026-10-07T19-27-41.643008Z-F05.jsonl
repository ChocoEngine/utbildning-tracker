{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,280p' tracker-app/app/src/main/java/com/utbildning/tracker/backup/AutomaticBackup.kt; sed -n '1,260p' tracker-app/app/src/androidTest/java/com/utbildning/tracker/backup/AutomaticBackupTest.kt; sed -n '280,360p' AGENTS.md\"","aggregated_output":"package com.utbildning.tracker.backup\n\nimport android.content.Context\nimport android.content.Intent\nimport android.net.Uri\nimport android.provider.DocumentsContract\nimport androidx.work.CoroutineWorker\nimport androidx.work.ExistingPeriodicWorkPolicy\nimport androidx.work.PeriodicWorkRequestBuilder\nimport androidx.work.WorkManager\nimport androidx.work.WorkerParameters\nimport com.utbildning.tracker.data.AppContainer\nimport java.io.IOException\nimport java.time.Instant\nimport java.time.ZoneOffset\nimport java.time.format.DateTimeFormatter\nimport java.util.concurrent.TimeUnit\n\ninternal data class AutomaticBackupStatus(\n    val enabled: Boolean,\n    val destination: Uri?,\n    val lastSuccessAt: Long?,\n    val lastErrorAt: Long?,\n)\n\ninternal class AutomaticBackupPreferences(context: Context) {\n    private val preferences = context.getSharedPreferences(NAME, Context.MODE_PRIVATE)\n\n    fun status(): AutomaticBackupStatus = AutomaticBackupStatus(\n        enabled = preferences.getBoolean(KEY_ENABLED, false),\n        destination = preferences.getString(KEY_DESTINATION, null)?.let(Uri::parse),\n        lastSuccessAt = preferences.longOrNull(KEY_LAST_SUCCESS),\n        lastErrorAt = preferences.longOrNull(KEY_LAST_ERROR),\n    )\n\n    fun selectDestination(destination: Uri) {\n        preferences.edit().putString(KEY_DESTINATION, destination.toString()).remove(KEY_LAST_ERROR).apply()\n    }\n\n    fun setEnabled(enabled: Boolean) {\n        preferences.edit().putBoolean(KEY_ENABLED, enabled).apply()\n    }\n\n    fun recordSuccess(at: Long) {\n        preferences.edit().putLong(KEY_LAST_SUCCESS, at).remove(KEY_LAST_ERROR).apply()\n    }\n\n    fun recordError(at: Long) {\n        preferences.edit().putLong(KEY_LAST_ERROR, at).apply()\n    }\n\n    private fun android.content.SharedPreferences.longOrNull(key: String): Long? =\n        if (contains(key)) getLong(key, 0L) else null\n\n    private companion object {\n        const val NAME = \"automatic_backup\"\n        const val KEY_ENABLED = \"enabled\"\n        const val KEY_DESTINATION = \"destination\"\n        const val KEY_LAST_SUCCESS = \"last_success\"\n        const val KEY_LAST_ERROR = \"last_error\"\n    }\n}\n\ninternal class AutomaticBackupManager(\n    private val context: Context,\n    private val preferences: AutomaticBackupPreferences = AutomaticBackupPreferences(context),\n    private val workManager: WorkManager = WorkManager.getInstance(context),\n) {\n    fun status(): AutomaticBackupStatus = preferences.status()\n\n    fun selectDestination(destination: Uri) {\n        context.contentResolver.takePersistableUriPermission(\n            destination,\n            Intent.FLAG_GRANT_READ_URI_PERMISSION or Intent.FLAG_GRANT_WRITE_URI_PERMISSION,\n        )\n        preferences.selectDestination(destination)\n    }\n\n    fun enable() {\n        check(preferences.status().destination != null) { \"Backup destination is not selected\" }\n        preferences.setEnabled(true)\n        enqueueUnique()\n    }\n\n    fun disable() {\n        preferences.setEnabled(false)\n        workManager.cancelUniqueWork(WORK_NAME)\n    }\n\n    fun recordError() {\n        preferences.recordError(System.currentTimeMillis())\n    }\n\n    fun reconcile() {\n        if (preferences.status().enabled) enqueueUnique() else workManager.cancelUniqueWork(WORK_NAME)\n    }\n\n    private fun enqueueUnique() {\n        val request = PeriodicWorkRequestBuilder<AutomaticBackupWorker>(7, TimeUnit.DAYS).build()\n        workManager.enqueueUniquePeriodicWork(WORK_NAME, ExistingPeriodicWorkPolicy.UPDATE, request)\n    }\n\n    companion object {\n        internal const val WORK_NAME = \"weekly-backup\"\n    }\n}\n\nclass AutomaticBackupWorker(\n    appContext: Context,\n    parameters: WorkerParameters,\n) : CoroutineWorker(appContext, parameters) {\n    override suspend fun doWork(): Result {\n        val preferences = AutomaticBackupPreferences(applicationContext)\n        val status = preferences.status()\n        if (!status.enabled) return Result.success()\n        val tree = status.destination ?: return failure(preferences)\n        var document: Uri? = null\n        return try {\n            document = createDocument(tree)\n            BackupExporter(applicationContext, AppContainer.repository(applicationContext)).export(document)\n            preferences.recordSuccess(System.currentTimeMillis())\n            Result.success()\n        } catch (cancel: kotlinx.coroutines.CancellationException) {\n            document?.let(::deleteIncomplete)\n            throw cancel\n        } catch (_: Exception) {\n            document?.let(::deleteIncomplete)\n            failure(preferences)\n        }\n    }\n\n    private fun createDocument(tree: Uri): Uri {\n        val resolver = applicationContext.contentResolver\n        val parent = DocumentsContract.buildDocumentUriUsingTree(tree, DocumentsContract.getTreeDocumentId(tree))\n        val timestamp = DateTimeFormatter.ofPattern(\"yyyyMMdd-HHmmss\")\n            .withZone(ZoneOffset.UTC).format(Instant.now())\n        return DocumentsContract.createDocument(\n            resolver,\n            parent,\n            BackupArchive.MIME,\n            \"study-tracker-$timestamp${BackupArchive.EXTENSION}\",\n        ) ?: throw IOException(\"Storage provider did not create a document\")\n    }\n\n    private fun deleteIncomplete(document: Uri) {\n        runCatching { DocumentsContract.deleteDocument(applicationContext.contentResolver, document) }\n    }\n\n    private fun failure(preferences: AutomaticBackupPreferences): Result {\n        preferences.recordError(System.currentTimeMillis())\n        return Result.failure()\n    }\n}\npackage com.utbildning.tracker.backup\n\nimport android.content.Context\nimport android.net.Uri\nimport androidx.room.Room\nimport androidx.test.core.app.ApplicationProvider\nimport androidx.test.ext.junit.runners.AndroidJUnit4\nimport androidx.work.WorkInfo\nimport androidx.work.ListenableWorker\nimport androidx.work.WorkManager\nimport androidx.work.testing.TestListenableWorkerBuilder\nimport com.utbildning.tracker.data.TrackerRepository\nimport com.utbildning.tracker.data.local.CourseEntity\nimport com.utbildning.tracker.data.local.TrackerDatabase\nimport java.io.ByteArrayInputStream\nimport java.io.ByteArrayOutputStream\nimport java.io.File\nimport java.util.concurrent.CountDownLatch\nimport java.util.concurrent.TimeUnit\nimport java.util.concurrent.atomic.AtomicBoolean\nimport kotlinx.coroutines.async\nimport kotlinx.coroutines.Dispatchers\nimport kotlinx.coroutines.runBlocking\nimport org.junit.After\nimport org.junit.Assert.assertEquals\nimport org.junit.Assert.assertFalse\nimport org.junit.Assert.assertNotNull\nimport org.junit.Assert.assertTrue\nimport org.junit.Before\nimport org.junit.Test\nimport org.junit.runner.RunWith\n\n@RunWith(AndroidJUnit4::class)\nclass AutomaticBackupTest {\n    private val context = ApplicationProvider.getApplicationContext<Context>()\n    private lateinit var database: TrackerDatabase\n    private lateinit var repository: TrackerRepository\n\n    @Before fun setUp() {\n        context.getSharedPreferences(\"automatic_backup\", Context.MODE_PRIVATE).edit().clear().commit()\n        WorkManager.getInstance(context).cancelUniqueWork(AutomaticBackupManager.WORK_NAME).result.get(10, TimeUnit.SECONDS)\n        database = Room.inMemoryDatabaseBuilder(context, TrackerDatabase::class.java).build()\n        repository = TrackerRepository(database)\n    }\n\n    @After fun tearDown() {\n        WorkManager.getInstance(context).cancelUniqueWork(AutomaticBackupManager.WORK_NAME).result.get(10, TimeUnit.SECONDS)\n        context.getSharedPreferences(\"automatic_backup\", Context.MODE_PRIVATE).edit().clear().commit()\n        database.close()\n    }\n\n    @Test fun repeatedEnableKeepsOnePeriodicJobAndDisableCancelsIt() {\n        val preferences = AutomaticBackupPreferences(context)\n        preferences.selectDestination(Uri.parse(\"content://example/tree/backups\"))\n        val manager = AutomaticBackupManager(context, preferences)\n\n        manager.enable()\n        manager.enable()\n        val scheduled = WorkManager.getInstance(context)\n            .getWorkInfosForUniqueWork(AutomaticBackupManager.WORK_NAME).get(10, TimeUnit.SECONDS)\n        assertEquals(1, scheduled.count { !it.state.isFinished })\n        assertTrue(scheduled.single { !it.state.isFinished }.state in setOf(WorkInfo.State.ENQUEUED, WorkInfo.State.RUNNING))\n\n        manager.disable()\n        WorkManager.getInstance(context).getWorkInfosForUniqueWork(AutomaticBackupManager.WORK_NAME).get(10, TimeUnit.SECONDS)\n        assertFalse(manager.status().enabled)\n        assertEquals(\n            0,\n            WorkManager.getInstance(context).getWorkInfosForUniqueWork(AutomaticBackupManager.WORK_NAME)\n                .get(10, TimeUnit.SECONDS).count { !it.state.isFinished },\n        )\n    }\n\n    @Test fun inaccessibleProviderRecordsErrorWithoutForgettingPreviousSuccess() {\n        val preferences = AutomaticBackupPreferences(context)\n        preferences.selectDestination(Uri.parse(\"content://missing.provider/tree/backups\"))\n        preferences.setEnabled(true)\n        preferences.recordSuccess(1234L)\n\n        val worker = TestListenableWorkerBuilder<AutomaticBackupWorker>(context).build()\n        val result = worker.startWork().get(10, TimeUnit.SECONDS)\n\n        assertEquals(ListenableWorker.Result.failure(), result)\n        assertEquals(1234L, preferences.status().lastSuccessAt)\n        assertNotNull(preferences.status().lastErrorAt)\n    }\n\n    @Test fun automaticArchiveCanBeValidatedAndRestored() = runBlocking {\n        val wanted = BackupSnapshot(\n            languageTag = \"en\",\n            categories = emptyList(),\n            courses = listOf(CourseEntity(\"automatic\", \"Automatic\", 2, 10, 20)),\n            topics = emptyList(), schedules = emptyList(), scheduleRules = emptyList(), sessions = emptyList(),\n        )\n        repository.replaceBackup(wanted, \"wanted\")\n        val bytes = ByteArrayOutputStream()\n        BackupExporter(context, repository).export(\n            openOutput = { bytes },\n            openInput = { ByteArrayInputStream(bytes.toByteArray()) },\n        )\n        repository.replaceBackup(\n            wanted.copy(courses = listOf(CourseEntity(\"old\", \"Old\", 1, 1, 1))),\n            \"old\",\n        )\n        val file = File.createTempFile(\"automatic-restore-\", BackupArchive.EXTENSION, context.cacheDir)\n        try {\n            file.writeBytes(bytes.toByteArray())\n            val importer = BackupImporter(context, repository, postRestore = {})\n            importer.restore(importer.validate(file))\n            assertEquals(wanted, repository.createBackupSnapshot(\"en\"))\n        } finally {\n            file.delete()\n        }\n    }\n\n    @Test fun manualAndAutomaticExportsDoNotWriteConcurrently() = runBlocking {\n        repository.replaceBackup(\n            BackupSnapshot(\"en\", emptyList(), listOf(CourseEntity(\"course\", \"Course\", 0, 1, 1)), emptyList(), emptyList(), emptyList(), emptyList()),\n            \"source\",\n        )\n        val firstEntered = CountDownLatch(1)\n        val releaseFirst = CountDownLatch(1)\n        val secondEntered = AtomicBoolean(false)\n        val firstBytes = ByteArrayOutputStream()\n        val secondBytes = ByteArrayOutputStream()\n        val exporter = BackupExporter(context, repository)\n        val first = async(Dispatchers.Default) {\n            exporter.export(\n                openOutput = {\n                    firstEntered.countDown()\n                    assertTrue(releaseFirst.await(10, TimeUnit.SECONDS))\n                    firstBytes\n                },\n                openInput = { ByteArrayInputStream(firstBytes.toByteArray()) },\n            )\n        }\n        assertTrue(firstEntered.await(10, TimeUnit.SECONDS))\n        val second = async(Dispatchers.Default) {\n            exporter.export(\n                openOutput = { secondEntered.set(true); secondBytes },\n                openInput = { ByteArrayInputStream(secondBytes.toByteArray()) },\n            )\n        }\n        Thread.sleep(150)\n        assertFalse(secondEntered.get())\n        releaseFirst.countDown()\n        first.await()\n        second.await()\n        assertTrue(secondEntered.get())\n    }\n}\n- Палитра: 10 спокойных цветов, уникальных среди незавершённых курсов. Показывать свободные цвета и собственный текущий. Завершение и удаление освобождают цвет сразу; история сохраняет прежний цвет.\n- Максимум 10 незавершённых курсов, включая курсы без расписания и на паузе. При лимите скрыть добавление курса и запретить создание при сохранении.\n- В MVP два режима, выбор при создании: «По расписанию» (темы необязательны) и «Без расписания» (нужен непустой список тем).\n- Без расписания: вручную отмечать любую тему пройденной и снимать отметку; прогресс по темам. Нет календарных записей, пятнышек, уведомлений и вопросов о занятиях. После прохождения всех тем предложить завершить курс. Очистка календаря не удаляет такой список.\n- Расписание: дни недели и время начала для каждого дня; окончание занятия и конечная дата необязательны.\n- Результаты занятия: «Пройдено», «Пропущено», «Без отметки». Их можно исправлять. По R03-N01 неотмеченное занятие хранит PENDING сегодня и вчера; после закрытия этого окна синхронизация записывает SKIPPED.\n- С расписанием и темами: после «Пройдено» выбрать галочками любое количество непройденных тем, в том числе не по порядку, либо «Позанимался, но пока ничего не завершил». Яркость пятнышка отражает факт занятия, прогресс курса — только завершённые темы.\n- Календарь показывает название курса и время. Темы по датам не распределяются: нет темы-ориентира, предварительных назначений или автоматического переноса. После занятия пользователь выбирает фактически пройденные темы, включая несколько лекций за раз.\n- Прошедшие занятия сохраняют результат и связи с завершёнными темами. Пропуск, отсутствие отметки и занятие без завершённых тем не закрывают темы и не перераспределяют будущий план.\n- В календаре сегодняшние и будущие занятия без результата подписываются «В плане». С началом следующего дня неотмеченные занятия только отображаются пропущенными, сохраняя PENDING в БД до закрытия окна сегодня/вчера; вчерашний результат исправляется в блоке «Вчера» экрана «Занятия», календарь остаётся без действий.\n- Календарь: клякса под датой, несколько занятий — полосы цветов курсов; без результата бледные, пройденные яркие, пропущенные бледные с крестиком.\n- Список курсов компактный, в стиле календаря: цвет, название, прогресс; нажатие открывает редактирование. По умолчанию незавершённые, внизу общее число завершённых и переключатель «Показать все» / «Показать незавершённые».\n- Без тем: отмечается факт занятия, прогресс — количество пройденных занятий, без процента.\n- Непройденные темы можно добавлять, удалять и переставлять; пройденные сохраняются в истории.\n- Список тем прокручивается без «Показать все»; в незавершённом курсе любого режима только долгое нажатие переключает прохождение, второе снимает отметку. Прокрутка отменяет жест. Ручная отметка не создаёт занятие.\n- При вставке списка совпадения с пройденными темами без учёта регистра/крайних пробелов блокируют применение и сохранение; показать номера конфликтующих строк, ничего не удалять автоматически.\n- Настройка дней и времени открывается кнопкой «Настроить» в блоке расписания.\n- Темы редактируются единой кнопкой «Редактировать список» в текстовом блоке: одна непустая строка — одна тема, доступны вставка целого списка, перестановка и удаление строк. В существующем курсе пройденные темы вне редактируемого блока; прогресс и идентификаторы неизменённых тем сохраняются. Есть применение и отмена; поштучные кнопки не нужны.\n- Уведомления приходят в момент начала занятия и, если результат ещё не задан, после окончания либо через 1,5 часа после начала. Нажатие открывает занятие; позднее начало после вопроса не дублируется.\n- Вопрос «Получилось позаниматься?» — карточка на экране «Занятия» после заданного окончания или через 1,5 часа после начала. Ответы: «Пройдено» / «Пропущено». Без модального окна; в тот же момент приходит уведомление о результате.\n- На экране «Занятия» показывать занятия с датой начала сегодня и вчера в отдельных независимо прокручиваемых блоках; позавчера и раньше не показывать. По R03-N01 на границе дня сохранять вчерашние `PENDING`; окончательный пропуск ставить занятиям старше вчера при догоняющей обработке на запуске/возврате/полуночи. Вчерашний результат можно исправить, результат сегодняшнего — указать раньше появления вопроса.\n- После последней темы предложить завершить курс. При отказе оставить активным, но не планировать новые занятия до добавления тем или настройки расписания заново.\n- Конечная дата расписания сама по себе курс не завершает.\n- Ручное завершение отмечает все темы пройденными; у начавшихся к моменту завершения занятий только исходные `PENDING` («Без отметки») становятся `DONE`. Уже отмеченные `DONE` и `SKIPPED` сохраняют результат. Все будущие занятия удаляются независимо от результата. Расписание и уведомления отключаются, цвет освобождается. Курс остаётся до ручного удаления. Это уточнение пользователя от 2026-10-04 заменяет прежнее превращение пропусков в DONE; реализовать в R02. Предварительная синхронизация не должна превратить исходный PENDING в SKIPPED перед завершением.\n- Удаление с подтверждением убирает курс, темы, календарь и уведомления, освобождает цвет.\n- Простая пауза входит в MVP: убрать расписание, будущие занятия и уведомления, сохранить прошлые занятия и прогресс. Курс остаётся незавершённым и занимает цвет; оформление паузы в списке обсудить позже.\n\n- Редактор: не показывать «текущий цвет выбран», «Курс ещё не завершён» и постоянную подсказку о долгом нажатии. Завершение, пауза и удаление оформлены одинаково; подтверждения компактные. Гайд по приложению подготовить в конце разработки.\n\n## После MVP — не реализовывать заранее\n\n- Оформление паузы в списке и возобновление; перенос одного занятия без изменения недельного правила.\n- Перезапуск завершённого курса: после явного предупреждения удалить все старые занятия, сбросить прохождение тем, сохранить сам курс и список тем, не восстанавливать расписание автоматически. В начале задачи обязательно отдельно согласовать цвет и сочетание с лимитом 10. Возможность предложить создание копии курса перед сбросом — отдельная будущая идея, не часть F12.\n- Переключение между списком тем без расписания и курсом по расписанию. При отключении расписания сохранять прошлые занятия, их результаты, связи с темами и прогресс; удалять будущие занятия без отметки и отключать уведомления. Переключение реализовано с сохранением прогресса в обе стороны; включение выполняется при сохранении формы расписания.\n- Ежедневная очистка календаря по единому скользящему сроку для всех курсов, без разделения на активные, приостановленные и завершённые. В настройках задаётся количество сохраняемых дней; удаляются занятия с локальной датой начала старше этого срока. Статус курса, просмотр и последнее изменение на границу не влияют. Значение по умолчанию, диапазон и возможность отключения согласовать в начале F15.\n- После очистки остаются курс, темы с их прохождением и расписание; отдельная итоговая статистика не создаётся. F16 выполняется ежедневным периодическим WorkManager-воркером и не обещает точный час запуска.\n- Резервные копии вручную и раз в неделю, выбранное место хранения, статус последней копии. Восстановление полностью заменяет данные после подтверждения, без объединения.\n\n## Карта проекта и текущее состояние\n\nСостояние 2026-09-26: в `tracker-app/` реализованы курсы и категории, редактор тем, недельное расписание, результаты занятий, календарь, «Сегодня», завершение/пауза/удаление, уведомления и гайд. Room — схема v3 с миграциями 1→2→3. Название и цвет занятия читаются из текущего курса; снимки удалены. Миграция и 58 тестов данных прошли на API 36. S22/S23 проверены на API 36: финальный прогон BUILD SUCCESSFUL, 13 JVM + 100 инструментальных тестов без ошибок/пропусков, при отключённой сети; отдельно подтверждены офлайн-запуск с отозванным POST_NOTIFICATIONS, реальные уведомления RU/EN, сохранность данных при смене языка и повторное открытие всех разделов гайда. После подключения иконки S24 повторены assembleDebug/lintDebug: BUILD SUCCESSFUL, 0 ошибок / 23 предупреждения. Исправления ревизии: сборка/lint/JVM успешны, целевые календарный набор 4 теста, жизненного цикла 5 тестов и RU/EN visual review прошли на API 36; подробности и снимки — [отчёт исправлений](docs/checks/mvp/FIXES-REVISION-2026-09-26.md). Скруглённая квадратная маска S24 ещё не проверена. S01/S20 остаются частичными из-за отложенного пользователем Android 13. API 36 не заменяет эту проверку; полностью проверенным на всех поддерживаемых версиях MVP не объявлен. Подробности, снимки и ограничения — [отчёт MVP](docs/checks/mvp/README.md). Следующая оставшаяся работа MVP — скруглённая квадратная маска S24 на поддерживающем её launcher и отложенный Android 13 после отдельного указания возобновить эту проверку; новые функции без запроса не добавлять.\n\n| Файл | Назначение |\n|---|---|\n| [tracker-app/README.md](tracker-app/README.md) | Закреплённые версии, окружение, сборка и запуск |\n| [tracker-app/app/src/main/java/com/utbildning/tracker/MainActivity.kt](tracker-app/app/src/main/java/com/utbildning/tracker/MainActivity.kt) | Точка входа, тема и навигация |\n| [