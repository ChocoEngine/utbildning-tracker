= [\"courseId\", \"date\", \"startMinute\"], unique = true),\ntracker-app/app/src/main/java/com/utbildning/tracker/data/local/Entities.kt:165:        Index(value = [\"date\", \"startMinute\"]),\ntracker-app/app/src/main/java/com/utbildning/tracker/data/local/Entities.kt:166:        Index(value = [\"result\", \"date\"]),\ntracker-app/app/src/main/java/com/utbildning/tracker/data/local/Entities.kt:170:data class SessionRecord(\ntracker-app/app/src/main/java/com/utbildning/tracker/data/local/Entities.kt:173:    val date: Long,\ntracker-app/app/src/main/java/com/utbildning/tracker/data/local/Entities.kt:174:    val startMinute: Int,\ntracker-app/app/src/main/java/com/utbildning/tracker/data/local/Entities.kt:176:    val updatedAt: Long,\ntracker-app/app/src/main/java/com/utbildning/tracker/data/local/Entities.kt:177:    val endMinute: Int? = null,\ntracker-app/app/src/main/java/com/utbildning/tracker/data/local/Entities.kt:181:        validateId(id)\ntracker-app/app/src/main/java/com/utbildning/tracker/data/local/Entities.kt:182:        validateId(courseId)\ntracker-app/app/src/main/java/com/utbildning/tracker/data/local/Entities.kt:183:        validateTime(startMinute, endMinute)\ntracker-app/app/src/main/java/com/utbildning/tracker/data/local/Entities.kt:187:data class SessionEntity(\ntracker-app/app/src/main/java/com/utbildning/tracker/data/local/Entities.kt:190:    val date: Long,\ntracker-app/app/src/main/java/com/utbildning/tracker/data/local/Entities.kt:191:    val startMinute: Int,\ntracker-app/app/src/main/java/com/utbildning/tracker/data/local/Entities.kt:195:    val updatedAt: Long,\ntracker-app/app/src/main/java/com/utbildning/tracker/data/local/Entities.kt:196:    val endMinute: Int? = null,\ntracker-app/app/src/main/java/com/utbildning/tracker/data/local/Entities.kt:201:        validateId(id)\ntracker-app/app/src/main/java/com/utbildning/tracker/data/local/Entities.kt:202:        validateId(courseId)\ntracker-app/app/src/main/java/com/utbildning/tracker/data/local/Entities.kt:203:        validateTime(startMinute, endMinute)\ntracker-app/app/src/main/java/com/utbildning/tracker/data/local/Entities.kt:207:    fun record() = SessionRecord(id, courseId, date, startMinute, createdAt, updatedAt, endMinute, result)\npackage com.utbildning.tracker.data.local\n\nimport androidx.room.Entity\nimport androidx.room.ColumnInfo\nimport androidx.room.ForeignKey\nimport androidx.room.Index\nimport androidx.room.PrimaryKey\n\nenum class SessionResult { PENDING, DONE, SKIPPED }\n\n/** Internal restore marker. It is deliberately excluded from portable backup data. */\n@Entity(tableName = \"backup_state\")\ndata class BackupStateEntity(\n    @PrimaryKey val key: String = \"committed_backup_id\",\n    val value: String,\n) {\n    init {\n        require(key == \"committed_backup_id\")\n        validateId(value)\n    }\n}\n\nprivate fun validateId(id: String) = require(id.isNotBlank())\nprivate fun validateTime(start: Int, end: Int?) {\n    require(start in 0..1439)\n    require(end == null || end in 0..1439)\n}\n\n@Entity(tableName = \"categories\")\ndata class CategoryEntity(@PrimaryKey val id: String, val name: String) {\n    init {\n        validateId(id)\n        require(name.isNotBlank())\n    }\n}\n\n@Entity(\n    tableName = \"courses\",\n    foreignKeys = [\n        ForeignKey(\n            entity = CategoryEntity::class,\n            parentColumns = [\"id\"],\n            childColumns = [\"categoryId\"],\n            onDelete = ForeignKey.SET_NULL,\n        ),\n    ],\n    indices = [\n        Index(\"categoryId\"),\n        Index(value = [\"colorId\"], unique = true, name = \"index_courses_active_color\"),\n    ],\n)\ndata class CourseEntity(\n    @PrimaryKey val id: String,\n    val name: String,\n    val colorId: Int?,\n    val createdAt: Long,\n    val updatedAt: Long,\n    val categoryId: String? = null,\n    val isCompleted: Boolean = false,\n    val isPaused: Boolean = false,\n    val completedAt: Long? = null,\n) {\n    init {\n        validateId(id)\n        require(name.isNotBlank())\n        require(colorId == null || colorId in 0..9)\n        categoryId?.let(::validateId)\n        require(isCompleted == (completedAt != null))\n        require(isCompleted == (colorId == null))\n    }\n}\n\n@Entity(\n    tableName = \"topics\",\n    foreignKeys = [\n        ForeignKey(\n            entity = CourseEntity::class,\n            parentColumns = [\"id\"],\n            childColumns = [\"courseId\"],\n            onDelete = ForeignKey.CASCADE,\n        ),\n    ],\n    indices = [\n        Index(value = [\"courseId\", \"position\"]),\n        Index(value = [\"id\", \"courseId\"], unique = true),\n    ],\n)\ndata class TopicEntity(\n    @PrimaryKey val id: String,\n    val courseId: String,\n    val position: Int,\n    val title: String,\n    @ColumnInfo(defaultValue = \"0\") val isCompleted: Boolean = false,\n    val completionDate: Long? = null,\n) {\n    init {\n        validateId(id)\n        validateId(courseId)\n        require(position >= 0)\n        require(title.isNotBlank())\n        require(isCompleted || completionDate == null)\n    }\n}\n\n@Entity(\n    tableName = \"schedules\",\n    foreignKeys = [\n        ForeignKey(\n            entity = CourseEntity::class,\n            parentColumns = [\"id\"],\n            childColumns = [\"courseId\"],\n            onDelete = ForeignKey.CASCADE,\n        ),\n    ],\n)\ndata class ScheduleEntity(\n    @PrimaryKey val courseId: String,\n    val startsOn: Long,\n    val endsOn: Long? = null,\n    val generatedThrough: Long? = null,\n) {\n    init {\n        validateId(courseId)\n        require(endsOn == null || endsOn >= startsOn)\n    }\n}\n\n@Entity(\n    tableName = \"schedule_rules\",\n    primaryKeys = [\"courseId\", \"dayOfWeek\"],\n    foreignKeys = [\n        ForeignKey(\n            entity = ScheduleEntity::class,\n            parentColumns = [\"courseId\"],\n            childColumns = [\"courseId\"],\n            onDelete = ForeignKey.CASCADE,\n        ),\n    ],\n)\ndata class ScheduleRuleEntity(\n    val courseId: String,\n    val dayOfWeek: Int,\n    val startMinute: Int,\n    val endMinute: Int? = null,\n) {\n    init {\n        validateId(courseId)\n        require(dayOfWeek in 1..7)\n        validateTime(startMinute, endMinute)\n    }\n}\n\n@Entity(\n    tableName = \"sessions\",\n    foreignKeys = [\n        ForeignKey(\n            entity = CourseEntity::class,\n            parentColumns = [\"id\"],\n            childColumns = [\"courseId\"],\n            onDelete = ForeignKey.CASCADE,\n        ),\n    ],\n    indices = [\n        Index(value = [\"courseId\", \"date\", \"startMinute\"], unique = true),\n        Index(value = [\"date\", \"startMinute\"]),\n        Index(value = [\"result\", \"date\"]),\n        Index(value = [\"id\", \"courseId\"], unique = true),\n    ],\n)\ndata class SessionRecord(\n    @PrimaryKey val id: String,\n    val courseId: String,\n    val date: Long,\n    val startMinute: Int,\n    val createdAt: Long,\n    val updatedAt: Long,\n    val endMinute: Int? = null,\n    val result: SessionResult = SessionResult.PENDING,\n) {\n    init {\n        validateId(id)\n        validateId(courseId)\n        validateTime(startMinute, endMinute)\n    }\n}\n\ndata class SessionEntity(\n    @PrimaryKey val id: String,\n    val courseId: String,\n    val date: Long,\n    val startMinute: Int,\n    val courseName: String,\n    val colorId: Int?,\n    val createdAt: Long,\n    val updatedAt: Long,\n    val endMinute: Int? = null,\n    val result: SessionResult = SessionResult.PENDING,\n    val courseCompleted: Boolean = false,\n) {\n    init {\n        validateId(id)\n        validateId(courseId)\n        validateTime(startMinute, endMinute)\n        require(courseName.isNotBlank())\n        require(colorId == null || colorId in 0..9)\n    }\n    fun record() = SessionRecord(id, courseId, date, startMinute, createdAt, updatedAt, endMinute, result)\n}\nСостояние 2026-09-26: в `tracker-app/` реализованы курсы и категории, редактор тем, недельное расписание, результаты занятий, календарь, «Сегодня», завершение/пауза/удаление, уведомления и гайд. Room — схема v3 с миграциями 1→2→3. Название и цвет занятия читаются из текущего курса; снимки удалены. Миграция и 58 тестов данных прошли на API 36. S22/S23 проверены на API 36: финальный прогон BUILD SUCCESSFUL, 13 JVM + 100 инструментальных тестов без ошибок/пропусков, при отключённой сети; отдельно подтверждены офлайн-запуск с отозванным POST_NOTIFICATIONS, реальные уведомления RU/EN, сохранность данных при смене языка и повторное открытие всех разделов гайда. После подключения иконки S24 повторены assembleDebug/lintDebug: BUILD SUCCESSFUL, 0 ошибок / 23 предупреждения. Исправления ревизии: сборка/lint/JVM успешны, целевые календарный набор 4 теста, жизненного цикла 5 тестов и RU/EN visual review прошли на API 36; подробности и снимки — [отчёт исправлений](docs/checks/mvp/FIXES-REVISION-2026-09-26.md). Скруглённая квадратная маска S24 ещё не проверена. S01/S20 остаются частичными из-за отложенного пользователем Android 13. API 36 не заменяет эту проверку; полностью проверенным на всех поддерживаемых версиях MVP не объявлен. Подробности, снимки и ограничения — [отчёт MVP](docs/checks/mvp/README.md). Следующая оставшаяся работа MVP — скруглённая квадратная маска S24 на поддерживающем её launcher и отложенный Android 13 после отдельного указания возобновить эту проверку; новые функции без запроса не добавлять.\n\n| Файл | Назначение |\n|---|---|\n| [tracker-app/README.md](tracker-app/README.md) | Закреплённые версии, окружение, сборка и запуск |\n| [tracker-app/app/src/main/java/com/utbildning/tracker/MainActivity.kt](tracker-app/app/src/main/java/com/utbildning/tracker/MainActivity.kt) | Точка входа, тема и навигация |\n| [tracker-app/app/src/main/java/com/utbildning/tracker/ui/AppNavigation.kt](tracker-app/app/src/main/java/com/utbildning/tracker/ui/AppNavigation.kt) | NavHost, вкладки, настройки и общая шапка |\n| [tracker-app/app/src/main/java/com/utbildning/tracker/ui/theme/](tracker-app/app/src/main/java/com/utbildning/tracker/ui/theme/) | Светлая тема и 10 цветов курсов |\n| [tracker-app/app/src/main/java/com/utbildning/tracker/ui/settings/SettingsScreen.kt](tracker-app/app/src/main/java/com/utbildning/tracker/ui/settings/SettingsScreen.kt) | Выбор языка через LocaleManager, автономный SettingsContent для Preview |\n| [docs/DATA_CONTRACT.md](docs/DATA_CONTRACT.md) | Контракт схемы v2, владение прохождением и транзакции |\n| [tracker-app/app/src/main/java/com/utbildning/tracker/data/local/](tracker-app/app/src/main/java/com/utbildning/tracker/data/local/) | Сущности, TrackerDao, TrackerDatabase |\n| [tracker-app/app/src/main/java/com/utbildning/tracker/data/TrackerRepository.kt](tracker-app/app/src/main/java/com/utbildning/tracker/data/TrackerRepository.kt) | Фасад операций курсов, тем, расписаний и результатов |\n| [tracker-app/app/src/main/java/com/utbildning/tracker/domain/TopicListEditor.kt](tracker-app/app/src/main/java/com/utbildning/tracker/domain/TopicListEditor.kt) | Чистый разбор списка, конфликты, FIFO сопоставление повторов |\n| [docs/checks/s06/README.md](docs/checks/s06/README.md) | Проверки редактора, истории и отката сохранения |\n| [docs/checks/s05/README.md](docs/checks/s05/README.md) | Проверки репозитория, конкурирующих записей и отката |\n| [tracker-app/app/schemas/](tracker-app/app/schemas/) | Экспорт Room v1/v2, миграция проверяется отдельно |\n| [tracker-app/app/src/main/java/com/utbildning/tracker/data/TrackerOperations.kt](tracker-app/app/src/main/java/com/utbildning/tracker/data/TrackerOperations.kt) | Генерация занятий, исправления результатов, завершение/пауза/удаление |\n| [tracker-app/app/src/main/java/com/utbildning/tracker/data/AppContainer.kt](tracker-app/app/src/main/java/com/utbildning/tracker/data/AppContainer.kt) | Общий контейнер БД и репозитория |\n| [tracker-app/app/src/main/java/com/utbildning/tracker/domain/ScheduleGenerator.kt](tracker-app/app/src/main/java/com/utbildning/tracker/domain/ScheduleGenerator.kt) | Чистая генерация и правила времени |\n| [tracker-app/app/src/main/java/com/utbildning/tracker/ui/](tracker-app/app/src/main/java/com/utbildning/tracker/ui/) | courses, schedule, session, calendar, today, settings, guide; автономные Preview |\n| [tracker-app/app/src/main/java/com/utbildning/tracker/notifications/ReminderScheduler.kt](tracker-app/app/src/main/java/com/utbildning/tracker/notifications/ReminderScheduler.kt) | Планирование, доставка и отмена напоминаний, receivers восстановления |\n| [docs/SCHEDULE_CONTRACT.md](docs/SCHEDULE_CONTRACT.md) | Даты, горизонт генерации, DST и ночные занятия |\n| [docs/NOTIFICATIONS.md](docs/NOTIFICATIONS.md) | Разрешения, точность и ограничения уведомлений |\n| [docs/checks/mvp/README.md](docs/checks/mvp/README.md) | Текущая контрольная точка, проверки и ограничения |\n| [docs/checks/s04/README.md](docs/checks/s04/README.md) | Проверки хранения, ограничений, каскадов и сохранения |\n| [docs/checks/s03/README.md](docs/checks/s03/README.md) | Проверки языка и Preview, снимки RU/EN |\n| [docs/checks/s02/README.md](docs/checks/s02/README.md) | Проверка S02 на Android 16, снимки RU/EN |\n| [AGENTS.md](AGENTS.md) | Краткий контекст и актуальная карта для новых чатов |\n| [DEVELOPMENT_PLAN.md](DEVELOPMENT_PLAN.md) | Полная концепция, правила и четыре этапа развития |\n| [MVP_PLAN.md](MVP_PLAN.md) | Последовательные задачи MVP и критерии готовности |\n| [design/mockups/README.md](design/mockups/README.md) | Каталог макетов, исходники и правила обновления |\n| [design/mockups/calendar.html](design/mockups/calendar.html) | Макет календаря для браузера |\n| [design/mockups/courses.html](design/mockups/courses.html) | Макет списка курсов для браузера |\n| [design/mockups/course-editor.html](design/mockups/course-editor.html) | Макет редактора существующего курса; актуальные правила — в MVP_PLAN |\n| [design/mockups/PALETTE.md](design/mockups/PALETTE.md) | 10 оттенков и правила резервирования цветов |\n| [design/mockups/schedule.html](design/mockups/schedule.html) | Отдельный макет настройки расписания; на согласовании |\n| [design/mockups/session-result.html](design/mockups/session-result.html) | Выбор пройденных тем и результат занятия; на согласовании |\n| [design/mockups/today.html](design/mockups/today.html) | Сегодня: текущие занятия, без списка прошлых; на согласовании |\n\nЗакреплены Kotlin / Compose compiler 2.3.10, Compose BOM 2025.12.00, Activity Compose 1.12.2, AGP 8.13.2, Gradle 8.13 и JDK 17. minSdk 33, compileSdk/targetSdk 36. Корень сборки — `tracker-app/`, единственный модуль — `tracker-app/app`, namespace — `com.utbildning.tracker`. Добавлена Navigation Compose 2.9.6. Подключены Room 2.8.4 / SQLite и KSP 2.3.6; уведомления используют AlarmManager с точным будильником, POST_NOTIFICATIONS и SCHEDULE_EXACT_ALARM. Поведение без разрешений и ограничения — в docs/NOTIFICATIONS.md. AGP оставлен без обновления.\n\nПоследовательность функциональных разделов MVP:\n\n1. Android-проект и навигация.\n2. Локальная модель данных.\n3. Курсы и категории, выбор режима, список тем без расписания.\n4. Недельное расписание и генерация занятий.\n5. Результаты занятий и отметки прохождения тем в обоих режимах.\n6. Месячный календарь.\n7. Экран «Сегодня» и вопрос о результате.\n8. Прогресс и завершение курса.\n9. Локальные уведомления.\n10. Сквозная проверка.\n11. Краткий гайд по приложению перед выпуском.\n\nОсновной реестр — чек-лист S01–S24 в MVP_PLAN.md. S01 частичен только из-за отложенного Android 13; S02–S19 реализованы и проверяются тестами API 36/JVM, S21 покрыт ReminderTest. S22/S23 завершены на API 36; S24 подключён и частично проверен (круговая/тематическая иконки), скруглённая квадратная маска недоступна в текущем launcher. В S01/S20 остался отложенный Android 13. Не начинать новые функции без запроса. LocaleManager остаётся единственным хранилищем языка; все экраны имеют Preview. Одно задание выполняет один шаг, если пользователь явно не запросил больший объём.\n\n## Архитектурные ориентиры и проверки\n\n- Разделять правило повторения, конкретное занятие и тему.\n- В схеме v2 история `session_topic_history` отделена от текущего источника `topic_completions`. DAO — только хранение; S05 реализует транзакции курсов/категорий и резервов цветов. S06 архивирует удалённые строки, исключает архив из редактора и повторно проверяет конфликты с прохождением при сохранении. Ручное прохождение, результаты, расписание и жизненный цикл выполняются транзакциями репозитория; прошлые снимки сохраняются. Не использовать историю для автоматического восстановления снятых отметок.\n- Прохождение темы может существовать без занятия; для ручных отметок в курсе без расписания не создавать фиктивные календарные записи.\n- Одно занятие связано с нулём, одной или несколькими фактически завершёнными темами; планового назначения темы нет. При исправлениях не дублировать прогресс и не сбрасывать темы других занятий.\n- Бессрочный календарь пополнять на ограниченный горизонт без дублей.\n- Изменять результат занятия и прохождение темы согласованно.\n- Проверять исправления прошлых отметок и отметки не по порядку, границы дат, исчерпание тем и конечную дату расписания.\n- Уведомления должны соответствовать актуальному календарю и отменяться при удалении или завершении курса.\n- Проверять сохранение данных после перезапуска, работу без сети, отказ в разрешении на уведомления и перезагрузку устройства.\n- Проверка из `tracker-app/`: `./gradlew :app:assembleDebug :app:lintDebug :app:testDebugUnitTest :app:connectedDebugAndroidTest --console=plain`, JDK 17, SDK Platform 36 / Build Tools 35.0.0. Устройство — `Medium_Phone_API_36` (Android 16). Текущие числа тестов, результаты и ограничения — [отчёт MVP](docs/checks/mvp/README.md), условия запуска — [tracker-app/README.md](tracker-app/README.md). Не выдавать промежуточный выборочный прогон за итоговую проверку всей сборки. Есть тесты файловой БД, миграции 1→2, сохранения черновика при настоящем пересоздании Activity и восстановления выбора тем/расписания. Рендер Preview в IDE и Android 13 не проверены; остальные незавершённые системные сценарии перечислены в отчёте.\n\n## Как поддерживать базу знаний\n\nПосле каждого шага разработки обновлять чек-лист S01–S24 в `MVP_PLAN.md` и краткое состояние в этом файле в рамках той же задачи. `[x]` ставить только после выполнения всех критериев и проверок. Для частичного выполнения оставлять `[ ]` и перечислять оставшуюся работу и проверки; для завершённого указывать краткий результат проверки или ссылку на отчёт. Основной реестр статусов — чек-лист MVP_PLAN.md.\n\nУдачные макеты сохраняй в `design/mockups/`, а не только в кеше чата. Редактируемые фрагменты храни в `design/mockups/sources/`, рядом поддерживай полные HTML-документы для браузера. После правок обновляй обе версии и каталог макетов. Для дальнейших изменений используй исходники проекта как основные.\n\nПосле существенной реализации или изменения согласованных решений обновляй этот файл в рамках той же задачи:\n\n- текущее состояние и следующий шаг, включая частично выполненные задачи;\n- выбранный стек, реальные пути ключевых модулей и точек входа;\n- команды сборки и проверок, фактический результат и ограничения проверки;\n- важные технические решения, известные проблемы и нерешённые вопросы.\n\nЗаменяй устаревшие сведения, не накапливай журнал всех действий. Держи файл кратким; подробности оставляй в планах или профильных документах со ссылками. При изменении продуктового правила синхронизируй соответствующие разделы планов. Не отмечай задачу выполненной без проверки её критериев и не придумывай пути или команды для ещё не созданного кода.\n\nСохраняй посторонние изменения пользователя. Коммиты и push выполняй только по его запросу; создание этого файла не разрешает их автоматически.\n\n- Экран расписания: без заголовка «Время для учёбы» и подписи «Каждую неделю». В блоке конечной даты только кнопка с календарём; выбранная дата отображается рядом со значком, появляется кнопка удаления ограничения. Отмена выбора сохраняет прежнее значение.\n\n- Экран выбора пройденных тем открывается после «Пройдено»: без вкладки «Пропущено» и подписи «Ранее пройдено…». Пропуск выбирается в боках «Сегодня» и «Вчера» экрана «Занятия»; календарь остаётся без действий. Здесь выбираются темы и сохраняется пройденное занятие, в том числе без завершённых тем.\n\nПроверки переключения режима 2026-09-26: сборка/lint/JVM и 15 целевых тестов API 36 успешны; [отчёт F14](docs/checks/f14/README.md).\n\n## Уточнение модели данных 2026-09-27\n\nРеализована схема v6 и миграции 4→5→6: без mode, archivedAt, endDayOffset, generationNotBefore, completionPromptDismissed и color_reservations. Темы и расписание необязательны; расписание определяется строкой schedules и доступно любому незавершённому курсу, включая паузу. Равные времена — 0 минут; окончание раньше начала — следующие сутки. Цвет завершённого курса NULL, редактирование запрещено; уникальность цветов незавершённых (включая паузу) защищает частичный индекс. Предложение завершить — только при отметке занятия, закрывшей последнюю тему; в курсе сообщение о всех пройденных темах. Генерация при запуске/возврате и границе суток; задним числом новые занятия не создаются. exhaustedAt удалено в v6; исчерпание вычисляется по непустому списку полностью пройденных тем. При остановке удаляются будущие PENDING и generatedThrough сбрасывается до вчерашнего дня; возобновление — с текущего момента. Напоминания наблюдают также темы. createdAt и updatedAt сохранены. Актуальные контракты — docs/DATA_CONTRACT.md и docs/SCHEDULE_CONTRACT.md; схема — docs/diagrams/database.html. Эти уточнения имеют приоритет над старым описанием режимов выше.\n\nПроверки изменений v5: сборки успешны, 15 JVM и 63 инструментальных теста данных прошли; исправленные CalendarIntegrationTest/CoursesScreenTest и уведомления — 16 тестов OK. Остальные UI-сценарии прошли в общем прогоне. lint: 0 ошибок / 27 предупреждений. Отчёт: docs/checks/schema-simplification/README.md. Android 13 после этих правок не проверялся.\n\nУдаление exhaustedAt (v6): сборка/lint/JVM успешны, 65 инструментальных тестов данных и 16 проверок уведомлений/календаря/списка курсов — OK на API 36. Диаграмма обновлена из экспорта Room v6. Android 13 и полный повторный UI-прогон не выполнялись. Отчёт: [docs/checks/exhaustion-removal/README.md](docs/checks/exhaustion-removal/README.md).\n\n","exit_code":0,"status":"completed"}}
