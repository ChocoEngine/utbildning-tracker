    <string name="retention_title">История календаря</string>
    <string name="retention_explanation">Для всех курсов сохраняются сегодня и выбранное число предыдущих календарных дней. Занятия раньше этой границы по локальной дате удаляются при очистке независимо от состояния курса и времени его последнего изменения.</string>
    <string name="retention_current">Хранить последние %1$d дней и сегодня</string>
    <string name="retention_disabled">Очистка выключена: хранить все занятия</string>
    <string name="retention_configure">Настроить срок хранения</string>
    <string name="retention_dialog_title">Срок хранения календаря</string>
    <string name="retention_dialog_explanation">По умолчанию — 365 дней. Выберите от 1 до 3650 дней или выключите очистку, чтобы хранить все занятия.</string>
    <string name="retention_cleanup_enabled">Удалять старые занятия</string>
    <string name="retention_days_label">Сколько предыдущих дней хранить</string>
    <string name="retention_range">От 1 до 3650 дней</string>
    <string name="retention_invalid">Введите целое число от 1 до 3650</string>
    <string name="retention_disabled_explanation">Все занятия календаря будут храниться, пока очистка снова не будет включена.</string>
    <string name="retention_save">Сохранить</string>
    <string name="retention_cancel">Отмена</string>
    <string name="retention_warning_title">Хранить меньше занятий?</string>
    <string name="retention_warning_message">При ближайшей очистке будет удалено больше старых записей: занятия раньше локальной границы для последних %1$d дней будут удалены.</string>
    <string name="retention_warning_confirm">Хранить меньше</string>
    <string name="backup_title">Резервная копия</string>
    <string name="backup_explanation">Сохраните все курсы, темы, историю, расписания и язык в одном файле.</string>
    <string name="backup_create">Создать копию</string>
    <string name="backup_creating">Создание копии…</string>
    <string name="backup_success">Копия создана</string>
    <string name="backup_cancelled">Создание копии отменено</string>
    <string name="backup_error">Не удалось создать копию</string>
    <string name="automatic_backup_title">Еженедельная копия</string>
    <string name="automatic_backup_explanation">Android создаёт новый файл примерно раз в неделю, когда позволяют фоновые условия. Точное время не гарантируется. Прежние успешные файлы сохраняются.</string>
    <string name="automatic_backup_enabled">Еженедельная копия включена</string>
    <string name="automatic_backup_disabled">Еженедельная копия выключена</string>
    <string name="automatic_backup_choose_folder">Выбрать папку</string>
    <string name="automatic_backup_change_folder">Сменить папку</string>
    <string name="automatic_backup_folder_selected">Папка для копий выбрана</string>
    <string name="automatic_backup_last_success">Последняя успешная копия: %1$s</string>
    <string name="automatic_backup_last_error">Последняя попытка не удалась: %1$s. Проверьте доступ к выбранной папке или выберите другое хранилище.</string>
    <string name="restore_title">Восстановление</string>
    <string name="restore_explanation">Выберите файл копии. Восстановление полностью заменит текущие курсы, темы, расписания, историю и язык.</string>
    <string name="restore_choose">Выбрать копию</string>
    <string name="restore_checking">Проверка копии…</string>
    <string name="restore_restoring">Восстановление…</string>
    <string name="restore_confirm_title">Заменить все данные трекера?</string>
    <string name="restore_confirm_message">Копия прошла проверку. Текущие данные будут полностью заменены; объединить копии нельзя.</string>
    <string name="restore_confirm">Заменить и восстановить</string>
    <string name="restore_cancel">Отмена</string>
    <string name="restore_success">Копия восстановлена</string>
    <string name="restore_cancelled">Восстановление отменено. Текущие данные не изменены.</string>
    <string name="restore_invalid">Файл копии повреждён или недоступен. Текущие данные не изменены.</string>
    <string name="restore_error">Не удалось завершить восстановление. Текущие или восстановленные данные сохранены; при необходимости перезапустите приложение.</string>
